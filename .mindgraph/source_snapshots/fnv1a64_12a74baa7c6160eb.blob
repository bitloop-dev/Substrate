            "input": {
                "accepted_plan": {
                    "architecture": {
                        "components": [
                            {
                                "id": "C-state",
                                "name": "Authoritative state and advancement",
                                "responsibility": "Own stable structural/material references, committed time, inventory ownership, staging, bounded retries, validity checks, and atomic interval acceptance."
                            },
                            {
                                "id": "C-structure",
                                "name": "Deformable structures",
