                                        "input_artifacts": [
                                            "AR-passive-coupling",
                                            "AR-work-package"
                                        ],
                                        "parent_id": "T-foundation",
                                        "plan_review": {
                                            "question": "Does the bounded two-way passive campaign support the candidate's local behavior, accumulated error and complete cost, or must the foundation change before species transport and resource/activity implementation?"
                                        },
                                        "title": "Qualify the two-way passive foundation"
                                    }
                                },
                                "evidence_ids": [
                                    "human-306e711065517ba8cc9d8cbf5862d3da"
                                ],
                                "reason": "Insert the requested bounded early evidence gate after implementation and before substantial downstream reliance."
