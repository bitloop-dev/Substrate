            "receipt": {
                "auth": "chatgpt",
                "model": "gpt-6-astra",
                "provider": "codex",
                "thread_id": "01a1167c-a2d7-73e2-8e83-1a0b5add94fb",
                "turn_id": "01a1167c-a339-7e23-b1ef-ec59b7bc6be1"
            },
            "response": "{\n  \"status\": \"ready\",\n  \"vision_summary\": \"Establish Substrate's first approved, resource-limited coupled organism proof: deformable tissue and pressure-bearing contents interacting with moving-boundary fluid, nutrients, and fuel-limited actuation. Qualify local physics, accumulated error, and complete CPU cost before expanding toward the proposed rich world. This initial plan does not authorize the full long-term feature set.\",\n  \"assumptions\": [\n    {\n      \"id\": \"A-scope\",\n      \"statement\": \"The initial deliverable is the bounded coupled foundation and its adoption decision, not the 256-organism rich world. Contact, damage, repair, growth, thermal transport, reproduction, and evolution follow only through separately approved plans.\"\n    },\n    {\n      \"id\": \"A-proof\",\n      \"statement\": \"The proposed first construction is a membrane swimmer with two connected pressure chambers, contractile elements, finite nutrient uptake, and a measured pumping path. It avoids organism-organism contact while exercising the essential coupled mechanisms.\"\n    },\n    {\n      \"id\": \"A-platform\",\n      \"statement\": \"CPU execution using double-precision authoritative physical state is the starting point. The proposed Ryzen 9 9950X3D, up to 16 workers, and workload targets require confirmation and an available measured execution configuration.\"\n    },\n    {\n      \"id\": \"A-resolution\",\n      \"statement\": \"Initial scenarios explicitly select well-mixed contents and fixed supported resolutions. Automatic representation switching, adaptive refinement, and unresolved internal circulation are excluded.\"\n    }\n  ],\n  \"architecture\": {\n    \"summary\": \"One project-owned transactional simulation core contains structural mechanics, inertial pressure compartments, an environmental finite-volume field, and compatible moving-boundary exchanges. Project-owned construction and controllers submit bounded local requests; a thin Bitloop shell advances and presents committed state. Numerical choices are provisional until bounded reference experiments, explicit human approval, and coupled qualification.\",\n    \"components\": [\n      {\n        \"id\": \"C-state\",\n        \"name\": \"Authoritative state and advancement\",\n        \"responsibility\": \"Own stable structural/material identities, physical time, inventories, units, validity checks, bounded retries, staging, and atomic commit of coupled advancement.\"\n      },\n      {\n        \"id\": \"C-structure\",\n        \"name\": \"Deformable structures\",\n        \"responsibility\": \"Own connected membrane and tissue degrees of freedom, mass, constitutive response, passive forces, and actuator attachment geometry.\"\n      },\n      {\n        \"id\": \"C-contents\",\n        \"name\": \"Well-mixed chamber contents\",\n        \"responsibility\": \"Own chamber material mass, species amounts, internal energy, pressure response, and declared unresolved-motion inertia consistent with actual chamber geometry.\"\n      },\n      {\n        \"id\": \"C-field\",\n        \"name\": \"Environmental flow and species\",\n        \"responsibility\": \"Own spatial fluid mass/momentum representation, pressure solution, finite-volume species amounts, and explicit exterior reservoir exchanges.\"\n      },\n      {\n        \"id\": \"C-interface\",\n        \"name\": \"Moving geometry and coupling\",\n        \"responsibility\": \"Derive sided membrane geometry, occupied areas, swept volumes, apertures, traction and flux operators, and paired structural/field exchanges.\"\n      },\n      {\n        \"id\": \"C-processes\",\n        \"name\": \"Resource-limited processes\",\n        \"responsibility\": \"Apply finite channel/permeability transfers, local reactions, and work-limited actuation through transactional requests without duplicating authoritative inventory.\"\n      },\n      {\n        \"id\": \"C-experiments\",\n        \"name\": \"Construction, control, and experiments\",\n        \"responsibility\": \"Build the proof organism and reference fixtures, provide constrained local sensing and deterministic controllers, and define quality/performance campaigns outside the core.\"\n      },\n      {\n        \"id\": \"C-shell\",\n        \"name\": \"Bitloop application adapter\",\n        \"responsibility\": \"Keep Substrate/Substrate.h and .cpp thin; own engine integration, fixed-step calls, drawing, configuration, semantic telemetry, and capture adapters.\"\n      }\n    ],\n    \"relationships\": [\n      {\n        \"from\": \"C-state\",\n        \"to\": \"C-structure\",\n        \"relationship\": \"Stages structural state and commits only a successful complete interval.\"\n      },\n      {\n        \"from\": \"C-state\",\n        \"to\": \"C-contents\",\n        \"relationship\": \"Owns the transaction containing chamber geometry-dependent updates and inventories.\"\n      },\n      {\n        \"from\": \"C-state\",\n        \"to\": \"C-field\",\n        \"relationship\": \"Coordinates field advancement and boundary source accounts on the same physical clock.\"\n      },\n      {\n        \"from\": \"C-structure\",\n        \"to\": \"C-interface\",\n        \"relationship\": \"Supplies oriented boundary geometry and motion; receives paired integrated traction impulses.\"\n      },\n      {\n        \"from\": \"C-interface\",\n        \"to\": \"C-field\",\n        \"relationship\": \"Supplies sided control-volume geometry and swept fluxes; receives pressure/viscous reactions and transport fluxes.\"\n      },\n      {\n        \"from\": \"C-contents\",\n        \"to\": \"C-interface\",\n        \"relationship\": \"Uses actual enclosed area and its derivatives for pressure force and work exchanges.\"\n      },\n      {\n        \"from\": \"C-processes\",\n        \"to\": \"C-state\",\n        \"relationship\": \"Submits paired amount, momentum, and energy updates for validation within the same transaction.\"\n      },\n      {\n        \"from\": \"C-experiments\",\n        \"to\": \"C-processes\",\n        \"relationship\": \"Issues local actuation and transfer requests constrained by measured local resources.\"\n      },\n      {\n        \"from\": \"C-experiments\",\n        \"to\": \"C-state\",\n        \"relationship\": \"Constructs initial physical state and observes committed local sensor values without controller mutation privileges.\"\n      },\n      {\n        \"from\": \"C-shell\",\n        \"to\": \"C-experiments\",\n        \"relationship\": \"Selects fixtures and exposes their committed-state telemetry and presentation.\"\n      },\n      {\n        \"from\": \"C-shell\",\n        \"to\": \"C-state\",\n        \"relationship\": \"Requests exact simulated intervals independently of rendering and displays failure at the last committed time.\"\n      }\n    ],\n    \"decisions\": [\n      {\n        \"id\": \"D-candidate\",\n        \"decision\": \"Investigate connected elastic structures, compressible well-mixed inertial chambers, and a staggered finite-volume incompressible viscous exterior with explicit sided cut-cell geometry.\",\n        \"rationale\": \"This directly tests the vision's preferred inexpensive representations without adopting predecessor engines or a universal particle model. Small-cell treatment and coupled stability remain explicit design and experiment obligations.\"\n      },\n      {\n        \"id\": \"D-domain\",\n        \"decision\": \"Use a bounded liquid domain with explicitly accounted pressure-reservoir outer boundaries for the first proof, rather than a sealed fixed-volume incompressible box.\",\n        \"rationale\": \"Changing chamber area must displace exterior liquid through compatible global boundary conditions. Domain-size sensitivity and reservoir work must be measured so boundary effects cannot masquerade as propulsion.\"\n      },\n      {\n        \"id\": \"D-authority\",\n        \"decision\": \"Store conserved amounts exactly once by material owner; use oriented, paired exchange records and one accepted advancement schedule.\",\n        \"rationale\": \"Geometry, flux, pressure work, resource use, rollback, and physical time must agree without duplicated inventory or skipped intervals.\"\n      },\n      {\n        \"id\": \"D-energy\",\n        \"decision\": \"Keep physical work, stored energy, physical dissipation, chemical energy, and numerical residual separate. Freeze local and cumulative error budgets before acceptance runs.\",\n        \"rationale\": \"Measured approximation is allowed; residual energy cannot fund activity, become heat automatically, or justify global velocity corrections.\"\n      },\n      {\n        \"id\": \"D-boundaries\",\n        \"decision\": \"Keep numerical state and laws independent of Bitloop lifecycle, UI, file output, scenario names, and diagnostic formats; reuse project adapters for existing framework workflows.\",\n        \"rationale\": \"Substrate owns its simulation and remains independently buildable without introducing a competing diagnostic framework.\"\n      },\n      {\n        \"id\": \"D-staging\",\n        \"decision\": \"Reach the smallest passive coupled proof before resource processes, controllers, population screening, or presentation work.\",\n        \"rationale\": \"Reject an unsuitable numerical foundation before investing in biology breadth, checkpoint serialization, contact complexity, or a backend menu.\"\n      },\n      {\n        \"id\": \"D-failure\",\n        \"decision\": \"Bound substeps, nonlinear iterations, geometry repairs, and retries; reject unsupported geometry or exhausted numerical budgets without changing committed state or silently relaxing quality.\",\n        \"rationale\": \"Transactional safety must preserve both physical time and the meaning of performance measurements.\"\n      }\n    ]\n  },\n  \"tasks\": [\n    {\n      \"id\": \"T-foundation\",\n      \"parent_id\": null,\n      \"title\": \"Establish the approved coupled experiment\",\n      \"goal\": \"Produce bounded, reconciled physical designs and an explicitly approved implementation package.\",\n      \"context\": \"Organizational outcome only. Scope follows A-scope; numerical descriptions are proposals, not adoption evidence.\",\n      \"components\": [\"C-state\", \"C-structure\", \"C-contents\", \"C-field\", \"C-interface\", \"C-processes\"],\n      \"depends_on\": [],\n      \"acceptance_criteria\": [\"The supervised workflow loop is assessed and the human explicitly accepts the reconciled experiment, budgets, and numerical candidate before production implementation.\"],\n      \"plan_review\": null,\n      \"input_artifacts\": []\n    },\n    {\n      \"id\": \"T-bootstrap\",\n      \"parent_id\": \"T-foundation\",\n      \"title\": \"Exercise one supervised Bitloop and MindGraph loop\",\n      \"goal\": \"Verify the actual project integration and evidence path with a minimal bounded task.\",\n      \"context\": \"Use capability bitloop, .mindgraph/project_capabilities/bitloop.md, and .agents/skills/bitloop-development/SKILL.md; use traces, .mindgraph/project_capabilities/traces.md, and references/tracing-diagnostics.md under that skill. Inspect active target, headers, project instructions, and development hooks. Compile the smallest project target and expose a minimal committed-time diagnostic if absent. No physical solver or framework edits. Have the supervisor inspect saved result, review routing, and reload; management faults belong to their owner.\",\n      \"components\": [\"C-shell\"],\n      \"depends_on\": [],\n      \"acceptance_criteria\": [\n        \"Record actual build/launch configuration, source identity, stable scene selection, and observed headless telemetry rather than assuming generated hooks work.\",\n        \"A supervised saved-result/review/reload exercise preserves decision-bearing observations; failures or unavailable steps are explicitly recorded with a minimal reproducer.\",\n        \"The result identifies ownership constraints and whether reliable execution of subsequent work is supported.\"\n      ],\n      \"plan_review\": {\n        \"question\": \"Does the supervised loop preserve enough real project evidence and instructions to release further work, or must an owning-project workflow issue be resolved first?\"\n      },\n      \"input_artifacts\": []\n    },\n    {\n      \"id\": \"T-budgets\",\n      \"parent_id\": \"T-foundation\",\n      \"title\": \"Specify fixtures, error budgets, and experiment limits\",\n      \"goal\": \"Make the first proof and its rejection criteria measurable before testing candidates.\",\n      \"context\": \"Use the supplied vision and A-proof. Define 2D units, geometry, coefficients, species, minimum features, supported deformation, relevant timescales, refinement levels, experiment resource caps, and reference calculations. Propose numerical tolerances relative to useful motion and resource flows, not background energy. Separate a one-organism adoption campaign from an optional 16-organism no-contact cost screen; neither establishes rich-world success. Confirm available hardware and publish how all staging/retry/solver costs and memory are counted.\",\n      \"components\": [\"C-experiments\"],\n      \"depends_on\": [\"T-bootstrap\"],\n      \"acceptance_criteria\": [\n        \"Fixtures cover equilibrium, translation/rotation, free expansion, compression, advection/diffusion, moving sealed barriers, pumping, and fuel-limited motion.\",\n        \"Each gate has a physical oracle, dimensional scale, proposed tolerance, refinement comparison, justified horizon, stopping condition, and bounded execution cost.\",\n        \"Proposed thresholds and deviations from the vision's provisional workload targets are clearly marked for human approval rather than silently adopted.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": []\n    },\n    {\n      \"id\": \"T-state-design\",\n      \"parent_id\": \"T-foundation\",\n      \"title\": \"Define state ownership and failure-safe advancement\",\n      \"goal\": \"Specify the shared transaction and exchange interfaces.\",\n      \"context\": \"Consume F-budgets; implement D-authority and D-failure at design level. Define stable IDs, dense private storage, units, read-only committed views, staged exchange records, source accounts, exact interval completion, bounded substeps/retries, and commit validation. Allocate staged storage by owner rather than requiring full deep copies at each inner iteration. Exclude serialization and generalized registries.\",\n      \"components\": [\"C-state\"],\n      \"depends_on\": [\"T-budgets\"],\n      \"acceptance_criteria\": [\n        \"Specify state and request/response shapes, exchange signs, ownership changes, deterministic ordering, and failure categories.\",\n        \"Worked examples show a successful paired transfer and a late coupled rejection preserving every inventory and the last valid physical time.\",\n        \"Define the pipeline slots and provisional staging memory budget that mechanism designs must satisfy.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-budgets\"]\n    },\n    {\n      \"id\": \"T-mechanics-design\",\n      \"parent_id\": \"T-foundation\",\n      \"title\": \"Design passive structural mechanics\",\n      \"goal\": \"Select a bounded elastic discretization and advancement rule for the proof body.\",\n      \"context\": \"Consume F-budgets and F-state-design. Start with connected membrane edges and area-bearing elastic elements, explicit masses, and energy-derived forces with a bounded implicit solve. Specify strain response, bending where necessary, physical damping, traction application, and supported deformation. No contact, damage, remeshing, or active work law in this task.\",\n      \"components\": [\"C-structure\"],\n      \"depends_on\": [\"T-budgets\", \"T-state-design\"],\n      \"acceptance_criteria\": [\n        \"Provide equations, units, force/energy derivatives, solver tolerances and limits, and the exact state/exchange interface.\",\n        \"Worked stretch, shear, rigid translation/rotation, and compression/recovery references separate physical damping from numerical loss.\",\n        \"Specify inversion, collapsing features, and nonconvergence rejection rules without deleting or freezing material.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-budgets\", \"F-state-design\"]\n    },\n    {\n      \"id\": \"T-contents-design\",\n      \"parent_id\": \"T-foundation\",\n      \"title\": \"Design inertial pressure-bearing compartments\",\n      \"goal\": \"Give cheap well-mixed contents an explicit mechanical and thermodynamic meaning.\",\n      \"context\": \"Consume F-budgets and F-state-design. Specify a reduced velocity ansatz tied to chamber boundary motion, its kinetic energy and generalized inertia, a compressible pressure/internal-energy law using actual polygon area, and pressure-work derivatives. Distinguish content mass from membrane mass. Define what unresolved flow this approximation excludes and how finite inlet/outlet momentum enters; do not prescribe arbitrary ejection velocity.\",\n      \"components\": [\"C-contents\"],\n      \"depends_on\": [\"T-budgets\", \"T-state-design\"],\n      \"acceptance_criteria\": [\n        \"Translation and rotation calculations recover declared content mass and inertia without double counting structural mass.\",\n        \"Compression and free-expansion worked examples use one geometric area for density, pressure force, and work.\",\n        \"Specify geometry admissibility, mass changes, flux momentum, energy accounting, and a concrete reference comparison that can reject the reduced inertia model.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-budgets\", \"F-state-design\"]\n    },\n    {\n      \"id\": \"T-field-design\",\n      \"parent_id\": \"T-foundation\",\n      \"title\": \"Design the stationary flow reference\",\n      \"goal\": \"Specify the finite-volume flow equations and global pressure problem independently of moving geometry.\",\n      \"context\": \"Consume F-budgets and F-state-design; follow D-candidate and D-domain. Define staggered velocity, pressure, viscosity, fluid density, discrete divergence/gradient, pressure gauge, reservoir conditions, solver/preconditioner, convergence criteria, and work/momentum accounts. Species transport is designed separately.\",\n      \"components\": [\"C-field\"],\n      \"depends_on\": [\"T-budgets\", \"T-state-design\"],\n      \"acceptance_criteria\": [\n        \"Provide a small worked pressure solve and stationary viscous-flow reference with compatible boundary flux and global volume constraints.\",\n        \"Specify pressure iteration limits, residual interpretation, force/work extraction, and costs to report.\",\n        \"State how reservoir inflow/outflow affects material, momentum, and energy balances and how finite-domain sensitivity will be tested.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-budgets\", \"F-state-design\"]\n    },\n    {\n      \"id\": \"T-geometry-design\",\n      \"parent_id\": \"T-foundation\",\n      \"title\": \"Design compatible moving-boundary operators\",\n      \"goal\": \"Resolve thin barriers, swept geometry, and small cut cells before coupling implementation.\",\n      \"context\": \"Consume F-budgets, F-state-design, and F-field-design. Define oriented membrane intersections, separately addressable fluid regions on opposite sides, aperture and swept-area calculations, traction interpolation, and compatible pressure-work operators. Choose a bounded conservative small-cell treatment that never aggregates across a barrier; specify minimum passage/support limits and continuity on support changes. No automatic adaptive mesh.\",\n      \"components\": [\"C-interface\", \"C-field\"],\n      \"depends_on\": [\"T-budgets\", \"T-state-design\", \"T-field-design\"],\n      \"acceptance_criteria\": [\n        \"Worked translating-wall and expanding-polygon examples close local swept-volume balances and match pressure work.\",\n        \"A worked membrane-crossed cell retains distinct species/flow connectivity on both sides.\",\n        \"Define degeneracy handling, small-cell stability limits, support-change continuity, narrow-passage rejection, and bounds on geometry work.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-budgets\", \"F-state-design\", \"F-field-design\"]\n    },\n    {\n      \"id\": \"T-process-design\",\n      \"parent_id\": \"T-foundation\",\n      \"title\": \"Design finite transport and reactions\",\n      \"goal\": \"Specify conservative species transport and physical channel/permeability exchanges.\",\n      \"context\": \"Consume F-budgets, F-state-design, F-contents-design, and F-geometry-design. Define field advection/diffusion of amounts, concentrations on changing volume, membrane permeability, finite channel conductance, transported momentum/enthalpy, and a small nutrient/fuel/waste/signal reaction vocabulary. Resolve shared donors and competing requests centrally; no instantaneous connected-chamber mixing.\",\n      \"components\": [\"C-processes\", \"C-field\", \"C-contents\"],\n      \"depends_on\": [\"T-budgets\", \"T-state-design\", \"T-contents-design\", \"T-geometry-design\"],\n      \"acceptance_criteria\": [\n        \"Worked advection, diffusion, two-chamber equilibration, and competing exhausted-donor cases preserve positivity and paired amounts.\",\n        \"Specify reaction stoichiometry, chemical energy, rates, explicit sinks/sources, and rejected-update behavior.\",\n        \"Define the distinction between selective solute permeation and bulk liquid transfer, including geometry/volume implications and barrier-safe interpolation.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-budgets\", \"F-state-design\", \"F-contents-design\", \"F-geometry-design\"]\n    },\n    {\n      \"id\": \"T-actuation-design\",\n      \"parent_id\": \"T-foundation\",\n      \"title\": \"Design work-limited local actuation\",\n      \"goal\": \"Prevent actuators and controllers from obtaining free work or privileged state access.\",\n      \"context\": \"Consume F-budgets, F-state-design, F-mechanics-design, and F-process-design. Define contractile requests, force-length/rate limits, positive and negative work policy, fuel reservation and settlement, efficiencies, and local sensing. Use no metabolic credit from numerical residual or negative mechanical work unless an explicit approved conversion law provides it.\",\n      \"components\": [\"C-processes\", \"C-experiments\"],\n      \"depends_on\": [\"T-budgets\", \"T-state-design\", \"T-mechanics-design\", \"T-process-design\"],\n      \"acceptance_criteria\": [\n        \"Worked loaded contraction, stall, eccentric loading, depleted fuel, and rejected-step cases account for force, work, fuel, and dissipation.\",\n        \"Specify how a trial step exceeding reserved work is limited or rejected without post-hoc energy creation.\",\n        \"Controller interfaces expose only declared local sensors and bounded requests, with deterministic cadence integrating elapsed physical time.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-budgets\", \"F-state-design\", \"F-mechanics-design\", \"F-process-design\"]\n    },\n    {\n      \"id\": \"T-reconcile\",\n      \"parent_id\": \"T-foundation\",\n      \"title\": \"Reconcile coupling and obtain experiment approval\",\n      \"goal\": \"Establish the implementable shared contract and explicit human go/no-go.\",\n      \"context\": \"Reconcile all named designs rather than invent missing mechanisms. Specify partitioned implicit structural/chamber/field iterations, common geometry evaluation times, traction and work pairing, process ordering, retry rollback, and convergence norms. Establish bounded candidate probes and their execution budgets. Present method limitations, proposed tolerances and performance thresholds to the human; no downstream implementation proceeds without explicit approval.\",\n      \"components\": [\"C-state\", \"C-structure\", \"C-contents\", \"C-field\", \"C-interface\", \"C-processes\"],\n      \"depends_on\": [\"T-budgets\", \"T-state-design\", \"T-mechanics-design\", \"T-contents-design\", \"T-field-design\", \"T-geometry-design\", \"T-process-design\", \"T-actuation-design\"],\n      \"acceptance_criteria\": [\n        \"A worked coupled step reconciles geometry, mass, inertia, pressure, work, transport, and rollback across every owner.\",\n        \"The package includes authoritative shared interfaces, pipeline order, reference expectations, fixed numerical budgets, hardware conditions, and conditional downstream release rules.\",\n        \"Record the human's explicit decision in task execution evidence; pending approval or rejection blocks dependent work. Missing or contradictory mechanisms return to their owning design task.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-budgets\", \"F-state-design\", \"F-mechanics-design\", \"F-contents-design\", \"F-field-design\", \"F-geometry-design\", \"F-process-design\", \"F-actuation-design\"]\n    },\n    {\n      \"id\": \"T-passive\",\n      \"parent_id\": null,\n      \"title\": \"Prove the passive coupled foundation\",\n      \"goal\": \"Build independently testable kernels and reject unsuitable moving-boundary coupling early.\",\n      \"context\": \"Organizational outcome. Children depend on explicit experiment approval; successful construction is distinct from candidate adoption.\",\n      \"components\": [\"C-state\", \"C-structure\", \"C-contents\", \"C-field\", \"C-interface\"],\n      \"depends_on\": [],\n      \"acceptance_criteria\": [\"A bounded coupled campaign reports physical refinement, cumulative error, and complete cost against the approved contract before biological implementation is released.\"],\n      \"plan_review\": null,\n      \"input_artifacts\": []\n    },\n    {\n      \"id\": \"T-state\",\n      \"parent_id\": \"T-passive\",\n      \"title\": \"Implement transactional state and core interfaces\",\n      \"goal\": \"Provide the shared ownership and advancement foundation.\",\n      \"context\": \"Implement F-contract only after T-reconcile's human approval. Keep production code outside the generated shell and free of diagnostic dependencies. Implement staged owner buffers, stable IDs, exchange accounts, exact-time semantics, and durable finite/validity checks; no checkpoint format.\",\n      \"components\": [\"C-state\"],\n      \"depends_on\": [\"T-reconcile\"],\n      \"acceptance_criteria\": [\n        \"Focused tests cover paired exchanges, invalid references, nonfinite proposals, bounded retry exhaustion, and complete rollback after a late failure.\",\n        \"Requested intervals either finish exactly or report the actual last committed time without skipped work.\",\n        \"Storage/staging measurements conform to the approved ownership model.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-contract\"]\n    },\n    {\n      \"id\": \"T-mechanics\",\n      \"parent_id\": \"T-passive\",\n      \"title\": \"Implement passive deformable structures\",\n      \"goal\": \"Deliver the independently tested structural kernel.\",\n      \"context\": \"Consume F-contract and F-core. Implement only approved passive mechanics and traction interfaces; exclude contact, topology changes, and actuators.\",\n      \"components\": [\"C-structure\"],\n      \"depends_on\": [\"T-reconcile\", \"T-state\"],\n      \"acceptance_criteria\": [\n        \"Translation, rotation, stretch, shear, and compression/recovery tests meet the frozen local error budgets.\",\n        \"Finite-difference energy/force checks and momentum/work balances expose implementation errors.\",\n        \"Inverted or collapsed elements and solver exhaustion reject safely.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-contract\", \"F-core\"]\n    },\n    {\n      \"id\": \"T-contents\",\n      \"parent_id\": \"T-passive\",\n      \"title\": \"Implement inertial chambers\",\n      \"goal\": \"Deliver pressure and contents inertia without internal particle populations.\",\n      \"context\": \"Consume F-contract and F-core. Test prescribed chamber motion independently of the field or structural solver; implement the approved geometric pressure and reduced-inertia law, not a scalar pressure-only placeholder.\",\n      \"components\": [\"C-contents\"],\n      \"depends_on\": [\"T-reconcile\", \"T-state\"],\n      \"acceptance_criteria\": [\n        \"Prescribed translation/rotation recover declared mass, inertia, and reactions.\",\n        \"Expansion/compression match pressure-area and work references under refinement.\",\n        \"Invalid area, unavailable mass, or invalid thermodynamic state leave committed contents unchanged.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-contract\", \"F-core\"]\n    },\n    {\n      \"id\": \"T-field\",\n      \"parent_id\": \"T-passive\",\n      \"title\": \"Implement stationary environmental flow\",\n      \"goal\": \"Establish a flow reference before introducing moving geometry.\",\n      \"context\": \"Consume F-contract and F-core. Implement approved staggered finite-volume flow and reservoir boundaries; exclude moving membranes and species. Include full pressure-solve costs rather than force-kernel timing alone.\",\n      \"components\": [\"C-field\"],\n      \"depends_on\": [\"T-reconcile\", \"T-state\"],\n      \"acceptance_criteria\": [\n        \"Uniform rest, pressure-driven viscous flow, and divergence/pressure references meet approved tolerances.\",\n        \"Reservoir volume, momentum, and work accounts agree with discrete boundary fluxes.\",\n        \"Tests record convergence iterations, memory, and bounded nonconvergence behavior.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-contract\", \"F-core\"]\n    },\n    {\n      \"id\": \"T-geometry\",\n      \"parent_id\": \"T-passive\",\n      \"title\": \"Implement sided moving geometry\",\n      \"goal\": \"Deliver geometry and exchange operators independently of dynamics.\",\n      \"context\": \"Consume F-contract and F-core. Implement cut regions, membrane sides, apertures, swept areas, small-cell treatment, and force/work maps. Use prescribed polygons and motions; no solver-specific corrective volume account.\",\n      \"components\": [\"C-interface\"],\n      \"depends_on\": [\"T-reconcile\", \"T-state\"],\n      \"acceptance_criteria\": [\n        \"Local swept-volume and pressure-work identities match worked references.\",\n        \"Corner crossings, vanishing support, and narrow supported passages preserve topology and continuous response within frozen budgets.\",\n        \"Opposite membrane sides never share ordinary interpolation or forbidden aggregation; unsupported geometry returns an explicit error.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-contract\", \"F-core\"]\n    },\n    {\n      \"id\": \"T-prescribed\",\n      \"parent_id\": \"T-passive\",\n      \"title\": \"Probe prescribed moving-boundary fluid response\",\n      \"goal\": \"Test the principal geometric and field risk before two-way integration.\",\n      \"context\": \"Consume F-contract, F-field, and F-geometry. Use capability traces via .mindgraph/project_capabilities/traces.md and .agents/skills/bitloop-development/references/tracing-diagnostics.md; implement required semantic metrics through a project adapter. Run the approved bounded moving-wall, expansion, small-cut-cell, and support-change cases, including complete setup and pressure costs.\",\n      \"components\": [\"C-interface\", \"C-field\", \"C-shell\"],\n      \"depends_on\": [\"T-reconcile\", \"T-field\", \"T-geometry\"],\n      \"acceptance_criteria\": [\n        \"Compare local fluid displacement, uniform-pressure equilibrium, traction, work, leakage, and refinement against frozen references.\",\n        \"Record timestep restrictions, geometry/pressure iteration tails, memory, and full simulated-interval cost.\",\n        \"Retain negative or inconclusive counterexamples with actual commands, configuration, semantic observations, and limits; successful experiment execution does not imply acceptance.\"\n      ],\n      \"plan_review\": {\n        \"question\": \"Do local geometry/transport behavior and complete prescribed-boundary cost support D-candidate's cut-cell approach, or must the moving-boundary representation change before two-way coupling?\"\n      },\n      \"input_artifacts\": [\"F-contract\", \"F-field\", \"F-geometry\"]\n    },\n    {\n      \"id\": \"T-coupling\",\n      \"parent_id\": \"T-passive\",\n      \"title\": \"Implement passive two-way coupling\",\n      \"goal\": \"Join structural motion, inertial contents, and exterior flow on one safe schedule.\",\n      \"context\": \"Consume F-contract and the tested component interfaces; proceed only if the T-prescribed review permits this foundation. Implement the approved coupled iteration and advancement semantics. Do not introduce new stabilizing laws, global energy correction, or unbudgeted retries.\",\n      \"components\": [\"C-state\", \"C-structure\", \"C-contents\", \"C-interface\", \"C-field\"],\n      \"depends_on\": [\"T-reconcile\", \"T-mechanics\", \"T-contents\", \"T-prescribed\"],\n      \"acceptance_criteria\": [\n        \"A passive chamber at rest and a perturbed relaxing body exercise both-way traction and area/work exchange.\",\n        \"Focused integrated tests detect unpaired impulses, inconsistent geometric area, double-counted inertia, and late failure rollback.\",\n        \"Provide a runnable passive fixture and instrumentation for complete-step phase costs and coupled convergence.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-contract\", \"F-mechanics\", \"F-contents\", \"F-prescribed\"]\n    },\n    {\n      \"id\": \"T-passive-campaign\",\n      \"parent_id\": \"T-passive\",\n      \"title\": \"Qualify coupled behavior and full cost\",\n      \"goal\": \"Produce the first decisive passive feasibility evidence.\",\n      \"context\": \"Consume F-contract and F-passive. Use simulation-health, .mindgraph/project_capabilities/simulation-health.md, and .agents/skills/bitloop-development/references/simulation-health-diagnostics.md; use traces and its routed tracing reference. Run the approved refinement levels and accumulation horizons for equilibrium, expansion, compression/recovery, translation/rotation, and weak-motion retention. Include domain-size sensitivity, small-cell degeneracy, all retries/staging, and pressure work.\",\n      \"components\": [\"C-experiments\", \"C-state\", \"C-interface\"],\n      \"depends_on\": [\"T-reconcile\", \"T-coupling\"],\n      \"acceptance_criteria\": [\n        \"Report local pressure/volume errors independently of global balances, sustained energy-growth tests, barrier leakage, inertia response, and numerical dissipation against fixed budgets.\",\n        \"Record dt, simulated time, cycles/timescales, complete-state inspection schedule, worst observations, refinement trends, and horizon stopping rationale.\",\n        \"Publish complete interval throughput, phase costs, retry/iteration tails, memory, hardware/build identity, and retained counterexamples whether the candidate passes or fails.\"\n      ],\n      \"plan_review\": {\n        \"question\": \"Does the coupled passive evidence support the chamber inertia, moving geometry, and bounded partitioned advancement in F-contract at affordable complete cost, or should the foundation be rejected before resource-limited biology?\"\n      },\n      \"input_artifacts\": [\"F-contract\", \"F-passive\"]\n    },\n    {\n      \"id\": \"T-active\",\n      \"parent_id\": null,\n      \"title\": \"Deliver the resource-limited organism proof\",\n      \"goal\": \"Exercise useful motion, pumping, nutrient exchange, and constrained control on the accepted passive foundation.\",\n      \"context\": \"Organizational outcome. Does not include the full rich-world workload or claim its throughput.\",\n      \"components\": [\"C-processes\", \"C-experiments\", \"C-shell\"],\n      \"depends_on\": [],\n      \"acceptance_criteria\": [\"A reproducible composed demonstration and a bounded adoption report establish supported behavior and cost or clearly recommend rejection.\"],\n      \"plan_review\": null,\n      \"input_artifacts\": []\n    },\n    {\n      \"id\": \"T-transport\",\n      \"parent_id\": \"T-active\",\n      \"title\": \"Implement conservative field species transport\",\n      \"goal\": \"Carry nutrients, fuel-related quantities, waste, and signals through the moving field without forbidden mixing.\",\n      \"context\": \"Consume F-contract and F-passive; release is conditional on T-passive-campaign review. Implement the approved advection/diffusion of amounts, reservoir species sources, changing-volume concentration evaluation, and barrier-safe connectivity. No permeability, reactions, or controllers yet.\",\n      \"components\": [\"C-field\", \"C-interface\"],\n      \"depends_on\": [\"T-reconcile\", \"T-coupling\", \"T-passive-campaign\"],\n      \"acceptance_criteria\": [\n        \"Advection/diffusion references quantify positivity, conservation, numerical diffusion, and gradient retention under refinement.\",\n        \"A moving sealed membrane preserves separated species even through cell/support changes.\",\n        \"Depleted cells and rejected field steps cannot create, destroy, or commit partial species updates.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-contract\", \"F-passive\"]\n    },\n    {\n      \"id\": \"T-transfers\",\n      \"parent_id\": \"T-active\",\n      \"title\": \"Implement finite transfers and reactions\",\n      \"goal\": \"Connect chamber and field inventories through finite physical paths.\",\n      \"context\": \"Consume F-contract and F-transport. Implement channel conductance, permeability, paired bulk/solute fluxes and their momentum/energy, competing donor allocation, and declared local reactions. Damage, rupture, repair, and general chemistry remain excluded.\",\n      \"components\": [\"C-processes\", \"C-contents\", \"C-field\"],\n      \"depends_on\": [\"T-reconcile\", \"T-transport\"],\n      \"acceptance_criteria\": [\n        \"Two chambers equilibrate at the finite reference rate rather than mixing instantaneously.\",\n        \"Selective permeability and bulk transfer obey their distinct volume, species, momentum, and energy contracts.\",\n        \"Exhausted donors, simultaneous requests, stiff reaction limits, and rejected updates preserve positivity and complete paired balances.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-contract\", \"F-transport\"]\n    },\n    {\n      \"id\": \"T-actuation\",\n      \"parent_id\": \"T-active\",\n      \"title\": \"Implement work-limited contraction\",\n      \"goal\": \"Make mechanical activity consume physically accounted local fuel.\",\n      \"context\": \"Consume F-contract, F-mechanics, and F-transfers. Implement actuator requests and trial-step fuel reservation/settlement exactly as approved. No organism-specific motion rules or controller framework.\",\n      \"components\": [\"C-processes\", \"C-structure\"],\n      \"depends_on\": [\"T-reconcile\", \"T-mechanics\", \"T-transfers\"],\n      \"acceptance_criteria\": [\n        \"Loaded contraction, stall, negative work, depleted fuel, and rollback match the worked references.\",\n        \"Positive actuator work cannot exceed the approved conversion of consumed fuel, including across retries.\",\n        \"Numerical residual and passive dissipation cannot become available chemical energy.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-contract\", \"F-mechanics\", \"F-transfers\"]\n    },\n    {\n      \"id\": \"T-organism\",\n      \"parent_id\": \"T-active\",\n      \"title\": \"Compose the swimmer and pumping experiment\",\n      \"goal\": \"Build the first resource-constrained organism using only shared physical mechanisms.\",\n      \"context\": \"Consume F-contract and F-actuation. Construct A-proof with explicit nutrient patches and pressure/load measurement sites. Start with scripted cyclic requests, then add a minimal deterministic local-sensing controller. No new physical mechanism may be invented in scenario code; report missing mechanisms instead.\",\n      \"components\": [\"C-experiments\", \"C-processes\"],\n      \"depends_on\": [\"T-reconcile\", \"T-actuation\"],\n      \"acceptance_criteria\": [\n        \"The same physical interfaces produce nutrient uptake, finite chamber transfer, measured pump work, and locomotion.\",\n        \"Fuel deprivation changes attainable activity; passive and disabled-actuator controls show no sustained unexplained propulsion.\",\n        \"Controllers read only declared local sensor values and issue bounded requests; deterministic replay on the declared execution configuration reproduces committed trajectories within the approved policy.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-contract\", \"F-actuation\"]\n    },\n    {\n      \"id\": \"T-active-campaign\",\n      \"parent_id\": \"T-active\",\n      \"title\": \"Assess active behavior, accumulated error, and scale screening\",\n      \"goal\": \"Decide whether the coupled organism is a useful foundation worth extending.\",\n      \"context\": \"Consume F-contract and F-organism. Use simulation-health and traces with .mindgraph/project_capabilities/simulation-health.md, .mindgraph/project_capabilities/traces.md, and the skill references simulation-health-diagnostics.md and tracing-diagnostics.md. Run frozen refinement and horizon campaigns; compare motion, pump transport/work, resource affordability, and gradient sensing. Execute the approved 16-organism shared-flow no-contact screen only within supported geometry; count all sensing/metabolism/actuation as activity. This is not the rich-world fixture.\",\n      \"components\": [\"C-experiments\", \"C-state\", \"C-processes\"],\n      \"depends_on\": [\"T-reconcile\", \"T-organism\"],\n      \"acceptance_criteria\": [\n        \"Report behavior under refinement, local and global balances, weak-motion preservation, fuel/work closure, accumulated residuals, and supported minimum features over justified activity/transport horizons.\",\n        \"Measure complete 0.02-s calculated frames including controls, staging, pressure solves, monitors, retries, and commit; report mean/tails/max, memory, active counts, and hardware/configuration.\",\n        \"Compare with the frozen first-proof thresholds and proposed laboratory target without claiming 256-organism acceptance or extrapolating projected speedups.\",\n        \"Retain successful, failed, and inconclusive observations with reasons for stopping and a clear adoption or rejection recommendation.\"\n      ],\n      \"plan_review\": {\n        \"question\": \"Do useful resource-limited motion and pumping survive refinement and accumulated-error horizons at sufficient complete CPU cost to extend this foundation, or do representation, scope, or explicitly human-approved budgets need reconsideration?\"\n      },\n      \"input_artifacts\": [\"F-contract\", \"F-organism\"]\n    },\n    {\n      \"id\": \"T-demo\",\n      \"parent_id\": \"T-active\",\n      \"title\": \"Package the inspectable proof and handoff\",\n      \"goal\": \"Provide a small reproducible human-facing demonstration and honest validity summary.\",\n      \"context\": \"Consume F-contract, F-organism, and F-active-report; package only behavior supported by the campaign review. Use bitloop and snapshots-checkpoints via .mindgraph/project_capabilities/bitloop.md and .mindgraph/project_capabilities/snapshots-checkpoints.md; route to .agents/skills/bitloop-development/SKILL.md and references/checkpoints-snapshots.md and visual-qa.md. Use snapshots only; checkpoint serialization is excluded. Keep drawing and telemetry in the thin project adapter and observational probes outside the core.\",\n      \"components\": [\"C-shell\", \"C-experiments\"],\n      \"depends_on\": [\"T-reconcile\", \"T-organism\", \"T-active-campaign\"],\n      \"acceptance_criteria\": [\n        \"Provide actual build/run/replay commands, deterministic initial configuration, retained semantic summaries, and inspected images explaining chambers, flux, fuel, and motion.\",\n        \"The shell advances physical time independently of rendering and visibly reports failure without pretending the requested interval completed.\",\n        \"Document supported scales, approximation limits, failed/unverified gates, measured rendering/capture overhead and user-facing throughput, and deferred rich-world requirements.\",\n        \"Remove superseded candidate production code and disposable probes after retaining useful findings; no framework or other-owner changes occur without explicit authorization.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-contract\", \"F-organism\", \"F-active-report\"]\n    }\n  ],\n  \"questions\": [],\n  \"artifacts\": [\n    {\n      \"id\": \"F-budgets\",\n      \"title\": \"Bounded experiment specification\",\n      \"description\": \"Proposed physical fixtures, scales, numerical and cumulative error budgets, hardware conditions, horizons, cost caps, and rejection criteria for human approval.\",\n      \"produced_by\": \"T-budgets\"\n    },\n    {\n      \"id\": \"F-state-design\",\n      \"title\": \"Ownership and advancement contract\",\n      \"description\": \"Authoritative state shapes, exchange records, identities, time semantics, staging layout, validation, and bounded rollback behavior.\",\n      \"produced_by\": \"T-state-design\"\n    },\n    {\n      \"id\": \"F-mechanics-design\",\n      \"title\": \"Passive mechanics specification\",\n      \"description\": \"Structural equations, discretization, solver limits, admissibility rules, interfaces, and worked force/energy references.\",\n      \"produced_by\": \"T-mechanics-design\"\n    },\n    {\n      \"id\": \"F-contents-design\",\n      \"title\": \"Compartment inertia and pressure specification\",\n      \"description\": \"Geometric pressure/energy law, reduced kinetic-energy model, transfer reactions, validity limits, and worked inertial and expansion references.\",\n      \"produced_by\": \"T-contents-design\"\n    },\n    {\n      \"id\": \"F-field-design\",\n      \"title\": \"Stationary field specification\",\n      \"description\": \"Discrete flow equations, global pressure and reservoir conditions, convergence limits, balances, and stationary reference calculations.\",\n      \"produced_by\": \"T-field-design\"\n    },\n    {\n      \"id\": \"F-geometry-design\",\n      \"title\": \"Moving geometry operator specification\",\n      \"description\": \"Sided cut-region representation, swept-volume and work operators, small-cell policy, support-change handling, and worked geometric references.\",\n      \"produced_by\": \"T-geometry-design\"\n    },\n    {\n      \"id\": \"F-process-design\",\n      \"title\": \"Transport and reaction specification\",\n      \"description\": \"Amount-based field transport, finite channel/permeability laws, donor allocation, reaction energetics, and worked conservative exchanges.\",\n      \"produced_by\": \"T-process-design\"\n    },\n    {\n      \"id\": \"F-actuation-design\",\n      \"title\": \"Actuation and sensing specification\",\n      \"description\": \"Local controller boundary, work-limited contraction law, fuel reservation/settlement, sign policies, and worked actuator references.\",\n      \"produced_by\": \"T-actuation-design\"\n    },\n    {\n      \"id\": \"F-contract\",\n      \"title\": \"Reconciled coupled implementation package\",\n      \"description\": \"Unified mechanism specifications, shared interfaces, coupled advancement algorithm, frozen proposed campaign settings, and limitations presented for explicit human approval. Its existence is not approval evidence.\",\n      \"produced_by\": \"T-reconcile\"\n    },\n    {\n      \"id\": \"F-core\",\n      \"title\": \"Transactional core interfaces\",\n      \"description\": \"Implemented owner storage, stable references, paired exchanges, committed-state access, and failure-safe advancement primitives with focused tests.\",\n      \"produced_by\": \"T-state\"\n    },\n    {\n      \"id\": \"F-mechanics\",\n      \"title\": \"Passive structural kernel\",\n      \"description\": \"Implemented deformable mechanics and traction interface with independent reference fixtures.\",\n      \"produced_by\": \"T-mechanics\"\n    },\n    {\n      \"id\": \"F-contents\",\n      \"title\": \"Inertial compartment kernel\",\n      \"description\": \"Implemented geometry-based pressure and contents inertia with prescribed-motion reference fixtures.\",\n      \"produced_by\": \"T-contents\"\n    },\n    {\n      \"id\": \"F-field\",\n      \"title\": \"Stationary flow kernel\",\n      \"description\": \"Implemented environmental flow, pressure solve, reservoir accounts, and stationary tests.\",\n      \"produced_by\": \"T-field\"\n    },\n    {\n      \"id\": \"F-geometry\",\n      \"title\": \"Sided geometric exchange operators\",\n      \"description\": \"Implemented cut geometry, apertures, swept-area and work maps with isolated geometric tests.\",\n      \"produced_by\": \"T-geometry\"\n    },\n    {\n      \"id\": \"F-prescribed\",\n      \"title\": \"Prescribed-boundary candidate package\",\n      \"description\": \"Runnable moving-boundary field path and compact bounded experiment findings, including retained failures and limits; not a declaration of adoption.\",\n      \"produced_by\": \"T-prescribed\"\n    },\n    {\n      \"id\": \"F-passive\",\n      \"title\": \"Passive coupled simulation path\",\n      \"description\": \"Implemented structure/contents/field integration, transactional coupled advancement, runnable fixtures, and phase-cost instrumentation.\",\n      \"produced_by\": \"T-coupling\"\n    },\n    {\n      \"id\": \"F-passive-report\",\n      \"title\": \"Passive coupled qualification report\",\n      \"description\": \"Refinement, accumulated-error, boundary-sensitivity, and complete-cost findings against the frozen experiment with a suitability recommendation.\",\n      \"produced_by\": \"T-passive-campaign\"\n    },\n    {\n      \"id\": \"F-transport\",\n      \"title\": \"Moving-field species transport\",\n      \"description\": \"Implemented conservative, barrier-aware field species transport and positivity/refinement fixtures.\",\n      \"produced_by\": \"T-transport\"\n    },\n    {\n      \"id\": \"F-transfers\",\n      \"title\": \"Finite transfer and reaction interfaces\",\n      \"description\": \"Implemented channel and membrane exchanges, donor limits, reactions, and paired momentum/energy accounting.\",\n      \"produced_by\": \"T-transfers\"\n    },\n    {\n      \"id\": \"F-actuation\",\n      \"title\": \"Resource-limited actuator interface\",\n      \"description\": \"Implemented work-bounded contraction with fuel settlement and rollback tests on the coupled resource path.\",\n      \"produced_by\": \"T-actuation\"\n    },\n    {\n      \"id\": \"F-organism\",\n      \"title\": \"Composed swimmer and pump fixture\",\n      \"description\": \"Runnable two-chamber construction, local deterministic controller, resource patches, disabled-process controls, and behavioral metrics.\",\n      \"produced_by\": \"T-organism\"\n    },\n    {\n      \"id\": \"F-active-report\",\n      \"title\": \"Active foundation adoption report\",\n      \"description\": \"Behavioral refinement, accumulation, resource affordability, full-cost and bounded population-screen findings with explicit unsupported claims and adoption recommendation.\",\n      \"produced_by\": \"T-active-campaign\"\n    },\n    {\n      \"id\": \"F-demo\",\n      \"title\": \"Inspectable coupled organism demonstration\",\n      \"description\": \"Thin Bitloop presentation, reproducible commands/configuration, inspected captures, validity summary, and measured presentation overhead for the supported proof.\",\n      \"produced_by\": \"T-demo\"\n    }\n  ]\n}",
            "target_revision": 0
        }
