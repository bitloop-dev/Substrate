                            "lines": "1: #include \"Substrate.h\"\r\n2: \r\n3: SIM_BEG;\r\n4: \r\n5: using namespace bl;\r\n6: \r\n7: /// ─────────────────────── project setup ───────────────────────\r\n8: \r\n9: void Substrate_Project::UI::sidebar()\r\n10: {\r\n11:     bl_scoped(viewport_count);\r\n12: \r\n13:     ImGui::SliderInt(\"Viewport Count\", &viewport_count, 1, 8);\r\n14: }\r\n15: \r\n16: void Substrate_Project::projectPrepare(Layout& layout)\r\n17: {\r\n18:     for (int i = 0; i < viewport_count; i++)\r\n19:         layout << create<Substrate_Scene>();\r\n20: }\r\n21: \r\n22: /// ────────────────────────── scene ──────────────────────────\r\n23: \r\n24: void Substrate_Scene::UI::sidebar()\r\n25: {\r\n26:     if (ImGui::CollapsingHeaderBox(\"View\", true))\r\n27:     {\r\n28:         bl_scoped(camera);\r\n29: \r\n30:         camera.populateUI();\r\n31:         ImGui::EndCollapsingHeaderBox();\r\n32:     }\r\n33: \r\n34: }\r\n35: \r\n36: void Substrate_Scene::sceneStart()\r\n37: {\r\n38:     /// Initialize the Scene.\r\n39: }\r\n40: \r\n41: void Substrate_Scene::sceneMounted([[maybe_unused]] Viewport* ctx)\r\n42: {\r\n43:     /// Initialize viewport.\r\n44:     camera.setOriginViewportAnchor(Anchor::CENTER);\r\n45:     // camera.focusWorldRect(*ctx, -100, -100, 100, 100);\r\n46: \r\n47:     /// Enable reverting to the current camera view.\r\n48:     camera.uiSetCurrentAsDefault();\r\n49: \r\n50:     /// Configure default navigator.\r\n51:     navigator.setTarget(camera);\r\n52:     navigator.setDirectCameraPanning(true);\r\n53: }\r\n54: \r\n55: void Substrate_Scene::sceneUnmounted([[maybe_unused]] Viewport* ctx)\r\n56: {\r\n57:     /// Release state owned specifically for this Viewport.\r\n58: }\r\n59: \r\n60: void Substrate_Scene::sceneDestroy()\r\n61: {\r\n62:     /// Release dynamically allocated Scene resources.\r\n63: }\r\n64: \r\n65: void Substrate_Scene::sceneProcess()\r\n66: {\r\n67:     /// Process the Scene once per frame, not once per viewport.\r\n68: \r\n69:     // redraw the scene every frame\r\n70:     requestRedraw(true);\r\n71: }\r\n72: \r\n73: void Substrate_Scene::viewportProcess(\r\n74:     [[maybe_unused]] Viewport* ctx,\r\n75:     [[maybe_unused]] double dt)\r\n76: {\r\n77:     /// Process one update for each mounted viewport every frame.\r\n78: }\r\n79: \r\n80: void Substrate_Scene::viewportDraw(Viewport* ctx) const\r\n81: {\r\n82:     /// Draw the Scene on this viewport without modifying simulation state.\r\n83:     ctx->transform(camera);\r\n84:     ctx->drawWorldAxis();\r\n85: }\r\n86: \r\n87: void Substrate_Scene::onEvent(Event e)\r\n88: {\r\n89:     if (e.ownedBy(this))\r\n90:         navigator.handleWorldNavigation(e, true);\r\n91: }\r\n92: \r\n93: // void Substrate_Scene::onPointerDown(PointerEvent e) {}\r\n94: // void Substrate_Scene::onPointerUp(PointerEvent e) {}\r\n95: // void Substrate_Scene::onPointerMove(PointerEvent e) {}\r\n96: // void Substrate_Scene::onWheel(PointerEvent e) {}\r\n97: // void Substrate_Scene::onKeyDown(KeyEvent e) {}\r\n98: // void Substrate_Scene::onKeyUp(KeyEvent e) {}\r\n99: \r\n100: #ifdef BITLOOP_DEV_MODE\r\n101: void Substrate_Scene::traceFrame([[maybe_unused]] SimTraceFrame& frame) const\r\n102: {\r\n103: }\r\n104: \r\n105: bool Substrate_Scene::saveCheckpoint([[maybe_unused]] SimCheckpointWriter& writer) const\r\n106: {\r\n107:     return false;\r\n108: }\r\n109: \r\n110: bool Substrate_Scene::loadCheckpoint([[maybe_unused]] const SimCheckpointReader& reader)\r\n111: {\r\n112:     return false;\r\n113: }\r\n114: #endif\r\n115: \r\n116: SIM_END;\r\n",
