                                        "edit": {
                                            "artifact": {
                                                "description": "Approved passive reference, repeated-cycle and refinement findings; local/cumulative error, rollback, complete cost and memory observations; retained counterexamples, limits and pass/reject/inconclusive conclusions. Not an approval record or species/active/population qualification.",
