                                "lines": "1: #include \"Substrate.h\"\r\n2: \r\n3: SIM_BEG;\r\n4: \r\n5: using namespace bl;\r\n6: \r\n7: /// ─────────────────────── project setup ───────────────────────\r\n8: \r\n9: void Substrate_Project::UI::sidebar()\r\n10: {\r\n11:     bl_scoped(viewport_count);\r\n12: \r\n13:     ImGui::SliderInt(\"Viewport Count\", &viewport_count, 1, 8);\r\n14: }\r\n15: \r\n16: void Substrate_Project::projectPrepare(Layout& layout)\r\n17: {\r\n18:     for (int i = 0; i < viewport_count; i++)\r\n19:         layout << create<Substrate_Scene>(\"substrate-\" + std::to_string(i));\r\n20: }\r\n21: \r\n22: /// ────────────────────────── scene ──────────────────────────\r\n23: \r\n24: void Substrate_Scene::UI::sidebar()\r\n25: {\r\n26:     if (ImGui::CollapsingHeaderBox(\"View\", true))\r\n27:     {\r\n28:         bl_scoped(camera);\r\n29: \r\n30:         camera.populateUI();\r\n31:         ImGui::EndCollapsingHeaderBox();\r\n32:     }\r\n33: \r\n34: }\r\n35: \r\n36: void Substrate_Scene::sceneStart()\r\n37: {\r\n38:     #ifdef BITLOOP_DEV_MODE\r\n39:     diagnostic_ticks = 0;\r\n40:     diagnostic_time_seconds = 0.0;\r\n41:     #endif\r\n42: }\r\n43: \r\n44: void Substrate_Scene::sceneMounted([[maybe_unused]] Viewport* ctx)\r\n45: {\r\n46:     /// Initialize viewport.\r\n47:     camera.setOriginViewportAnchor(Anchor::CENTER);\r\n48:     // camera.focusWorldRect(*ctx, -100, -100, 100, 100);\r\n49: \r\n50:     /// Enable reverting to the current camera view.\r\n51:     camera.uiSetCurrentAsDefault();\r\n52: \r\n53:     /// Configure default navigator.\r\n54:     navigator.setTarget(camera);\r\n55:     navigator.setDirectCameraPanning(true);\r\n56: }\r\n57: \r\n58: void Substrate_Scene::sceneUnmounted([[maybe_unused]] Viewport* ctx)\r\n59: {\r\n60:     /// Release state owned specifically for this Viewport.\r\n61: }\r\n62: \r\n63: void Substrate_Scene::sceneDestroy()\r\n64: {\r\n65:     /// Release dynamically allocated Scene resources.\r\n66: }\r\n67: \r\n68: void Substrate_Scene::sceneProcess()\r\n69: {\r\n70:     #ifdef BITLOOP_DEV_MODE\r\n71:     ++diagnostic_ticks;\r\n72:     // Bitloop frame_dt() is milliseconds; this is a lifecycle observable, not physical state.\r\n73:     diagnostic_time_seconds += frame_dt() * 0.001;\r\n74:     #endif\r\n75: \r\n76:     // redraw the scene every frame\r\n77:     requestRedraw(true);\r\n78: }\r\n79: \r\n80: void Substrate_Scene::viewportProcess(\r\n81:     [[maybe_unused]] Viewport* ctx,\r\n82:     [[maybe_unused]] double dt)\r\n83: {\r\n84:     /// Process one update for each mounted viewport every frame.\r\n85: }\r\n86: \r\n87: void Substrate_Scene::viewportDraw(Viewport* ctx) const\r\n88: {\r\n89:     /// Draw the Scene on this viewport without modifying simulation state.\r\n90:     ctx->transform(camera);\r\n91:     ctx->drawWorldAxis();\r\n92: \r\n93:     #ifdef BITLOOP_DEV_MODE\r\n94:     ctx->stageMode();\r\n95:     ctx->setFillStyle(255, 255, 255);\r\n96:     ctx->setFontSize(18);\r\n97:     ctx->fillText(\"Diagnostic pilot - no physics\", 20.0, 30.0);\r\n98:     ctx->fillText(\"ticks = \" + std::to_string(diagnostic_ticks), 20.0, 55.0);\r\n99:     ctx->fillText(\"time (s) = \" + std::to_string(diagnostic_time_seconds), 20.0, 80.0);\r\n100:     #endif\r\n101: }\r\n102: \r\n103: void Substrate_Scene::onEvent(Event e)\r\n104: {\r\n105:     if (e.ownedBy(this))\r\n106:         navigator.handleWorldNavigation(e, true);\r\n107: }\r\n108: \r\n109: // void Substrate_Scene::onPointerDown(PointerEvent e) {}\r\n110: // void Substrate_Scene::onPointerUp(PointerEvent e) {}\r\n111: // void Substrate_Scene::onPointerMove(PointerEvent e) {}\r\n112: // void Substrate_Scene::onWheel(PointerEvent e) {}\r\n113: // void Substrate_Scene::onKeyDown(KeyEvent e) {}\r\n114: // void Substrate_Scene::onKeyUp(KeyEvent e) {}\r\n115: \r\n116: #ifdef BITLOOP_DEV_MODE\r\n117: void Substrate_Scene::traceFrame(SimTraceFrame& frame) const\r\n118: {\r\n119:     frame.metric(\"diagnostic_ticks\", static_cast<double>(diagnostic_ticks));\r\n120:     frame.metric(\"diagnostic_time_seconds\", diagnostic_time_seconds);\r\n121:     frame.metric(\"diagnostic_kind\", \"lifecycle_only_no_physics\");\r\n122: }\r\n123: \r\n124: bool Substrate_Scene::saveCheckpoint([[maybe_unused]] SimCheckpointWriter& writer) const\r\n125: {\r\n126:     return false;\r\n127: }\r\n128: \r\n129: bool Substrate_Scene::loadCheckpoint([[maybe_unused]] const SimCheckpointReader& reader)\r\n130: {\r\n131:     return false;\r\n132: }\r\n133: #endif\r\n134: \r\n135: SIM_END;\r\n",
