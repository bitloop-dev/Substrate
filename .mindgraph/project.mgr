            "model": "gpt-6-astra",
            "provider": "codex",
            "thread_id": "01a11e55-79db-77e3-b23f-9ef14c4c56d9",
            "turn_id": "01a11e55-7a4b-78a2-9299-eea946c59610"
        },
        "response": "{\n  \"status\": \"ready\",\n  \"vision_summary\": \"Build and qualify Substrate's first coupled organism foundation, followed by an interactive 16-organism laboratory. Prove deformable structures, honest pressure-bearing compartments, moving-boundary fluid coupling, nutrient transfer and fuel-limited activity before expanding features. Hundreds-organism rich-world acceptance remains a subsequent, separately approved campaign.\",\n  \"assumptions\": [\n    {\n      \"id\": \"A-scope\",\n      \"statement\": \"This initial work package delivers the coupled proof and interactive laboratory, including crawling, swimming and pumping constructions. The 256-organism rich world, its damage/repair schedule, thermal state and ten-minute endurance campaign are later scope, not claimed by this delivery. The human work-package approval explicitly confirms this boundary.\"\n    },\n    {\n      \"id\": \"A-method\",\n      \"statement\": \"Connected compliant elements, geometry-coupled well-mixed chambers and conservative cut-cell grid flow are hypotheses, not adopted solvers. Failed or inconclusive physical gates block dependent implementation pending review and an explicitly applied plan change.\"\n    },\n    {\n      \"id\": \"A-budgets\",\n      \"statement\": \"Physical scales, error budgets, minimum features, iteration/retry limits and laboratory endurance horizons must be designed and approved before qualification. The proposed laboratory throughput target is at least one simulated second per wall-clock second on the declared reference configuration; no unmeasured rich-world extrapolation establishes acceptance.\"\n    },\n    {\n      \"id\": \"A-ownership\",\n      \"statement\": \"All planned changes stay within Substrate. Framework, dependency-ownership or sibling-project changes require separate explicit authorization immediately before writing; incompatibility is reported rather than repaired outside this boundary.\"\n    },\n    {\n      \"id\": \"A-evidence\",\n      \"statement\": \"Every work task maps its artifact IDs to actual paths and source/configuration identities, retains compact decisive findings, and reports commands, units, thresholds, failures, skipped checks and uncertainty in supported MindGraph result fields. Raw diagnostic runs use .codex/runs; artifacts are not substitutes for recorded outcomes or approval.\"\n    }\n  ],\n  \"architecture\": {\n    \"summary\": \"One project-owned simulation state advances transactionally through explicit mechanical, compartment, field and biological exchanges. The inspected repository currently contains a generated Bitloop shell, empty semantic telemetry and checkpoint hooks returning false; no physical implementation or build compatibility is assumed. A passive coupled qualification precedes downstream biological work, and a resource-limited active proof precedes laboratory expansion.\",\n    \"components\": [\n      {\n        \"id\": \"C-world\",\n        \"name\": \"World state and advancement\",\n        \"responsibility\": \"Own stable structural/material references, authoritative committed state, units, advancement schedule, bounded retries and validity checks. Preserve the last valid state and actual time on failure.\"\n      },\n      {\n        \"id\": \"C-mechanics\",\n        \"name\": \"Structure mechanics\",\n        \"responsibility\": \"Own connected tissue, membranes, fibers and stiff supports; calculate deformation, contact and mechanical reactions at supported resolution.\"\n      },\n      {\n        \"id\": \"C-contents\",\n        \"name\": \"Compartment contents\",\n        \"responsibility\": \"Own well-mixed inventories, mass/inertia closure and pressure derived from actual chamber geometry; expose finite paired transfers and pressure work.\"\n      },\n      {\n        \"id\": \"C-fluid\",\n        \"name\": \"Resolved fluid and transport\",\n        \"responsibility\": \"Own grid control-volume inventories, momentum, pressure solve and species transport in environmental or explicitly resolved internal fluid.\"\n      },\n      {\n        \"id\": \"C-boundary\",\n        \"name\": \"Geometry and exchange coupling\",\n        \"responsibility\": \"Derive cut geometry and sided barriers from authoritative structures; reconcile swept volumes, fluxes, pressure forces, work and support transitions without owning duplicate inventory.\"\n      },\n      {\n        \"id\": \"C-biology\",\n        \"name\": \"Construction and local activity\",\n        \"responsibility\": \"Compose organisms using common material interfaces; own deterministic local controllers and reaction rules that request resource-limited actuation and transfers.\"\n      },\n      {\n        \"id\": \"C-app\",\n        \"name\": \"Bitloop application and experiment adapters\",\n        \"responsibility\": \"Keep Substrate.h/.cpp thin; own configuration, rendering, camera/input, recording, semantic trace adapters and explicit checkpoint serialization.\"\n      }\n    ],\n    \"relationships\": [\n      {\n        \"from\": \"C-world\",\n        \"to\": \"C-mechanics\",\n        \"relationship\": \"Schedules mechanical proposals and validates their committed state.\"\n      },\n      {\n        \"from\": \"C-world\",\n        \"to\": \"C-contents\",\n        \"relationship\": \"Schedules inventory and pressure updates with paired exchange accounting.\"\n      },\n      {\n        \"from\": \"C-world\",\n        \"to\": \"C-fluid\",\n        \"relationship\": \"Schedules conservative field advancement and pressure convergence checks.\"\n      },\n      {\n        \"from\": \"C-mechanics\",\n        \"to\": \"C-boundary\",\n        \"relationship\": \"Supplies geometry, motion and supported contact boundaries; receives reaction impulses.\"\n      },\n      {\n        \"from\": \"C-boundary\",\n        \"to\": \"C-fluid\",\n        \"relationship\": \"Supplies sided control volumes, swept-volume fluxes and wall conditions; receives pressure traction and fluid work.\"\n      },\n      {\n        \"from\": \"C-boundary\",\n        \"to\": \"C-contents\",\n        \"relationship\": \"Supplies actual chamber area and opening geometry; exchanges pressure work and finite transfers.\"\n      },\n      {\n        \"from\": \"C-biology\",\n        \"to\": \"C-world\",\n        \"relationship\": \"Reads constrained local observations and submits validated local actuation/transfer requests.\"\n      },\n      {\n        \"from\": \"C-app\",\n        \"to\": \"C-world\",\n        \"relationship\": \"Constructs experiments, requests simulated intervals and observes immutable committed state without viewport-dependent advancement.\"\n      }\n    ],\n    \"decisions\": [\n      {\n        \"id\": \"D-boundary\",\n        \"decision\": \"Keep physics independent of Scene, UI, rendering, input, scenario names, trace formatting and file output.\",\n        \"rationale\": \"Preserves independent numerical tests, authoritative ownership and a thin existing application shell.\"\n      },\n      {\n        \"id\": \"D-representation\",\n        \"decision\": \"Investigate compliant connected elements, well-mixed chambers and conservative grid flow with explicit sided moving barriers.\",\n        \"rationale\": \"Tests the preferred affordable representation while exposing small-cell, pressure-solve and two-way coupling risks before biological expansion.\"\n      },\n      {\n        \"id\": \"D-accounting\",\n        \"decision\": \"Use area-based two-dimensional units and explicit paired amount, impulse and work exchanges; distinguish physical dissipation from numerical residual.\",\n        \"rationale\": \"Prevents geometry/inventory disagreement, duplicate ownership and numerical error becoming usable biological energy.\"\n      },\n      {\n        \"id\": \"D-failure\",\n        \"decision\": \"Advance requested intervals with bounded staging/retries; never skip time, erase unsupported features or silently freeze active dynamics.\",\n        \"rationale\": \"Transactional validity and honest failure are hard requirements, but full deep copies at every substep are not prescribed.\"\n      },\n      {\n        \"id\": \"D-gates\",\n        \"decision\": \"Qualify passive coupling first, then nutrient/fuel-limited active behavior, then interacting laboratory scale.\",\n        \"rationale\": \"Passive moving-boundary failure must be discovered before transport and control investment. Active behavior is still mandatory before foundation adoption.\"\n      },\n      {\n        \"id\": \"D-later\",\n        \"decision\": \"Defer automatic representation switching, adaptive refinement, general fracture/remeshing, growth/repair/reproduction, evolution, thermal/phase/electrical models and rich-world scale.\",\n        \"rationale\": \"These remain vision requirements for later work packages, not prerequisites or promised features of the bounded initial laboratory.\"\n      }\n    ]\n  },\n  \"tasks\": [\n    {\n      \"id\": \"T-pilot\",\n      \"parent_id\": null,\n      \"title\": \"Run a supervised Bitloop evidence pilot\",\n      \"goal\": \"Establish a real project-owned build and diagnostic path before physical implementation.\",\n      \"context\": \"Inspected CMakeLists.txt uses bitloop_new_project; Substrate traceFrame is empty and checkpoint hooks return false. Use capability bitloop and traces, with snapshots-checkpoints for one inspected image. Workers load the declared bitloop-development entry and only relevant references. Preserve user build state; use a Codex-owned build. Implement only a deterministic diagnostic observable, not placeholder physics.\",\n      \"components\": [\"C-app\"],\n      \"depends_on\": [],\n      \"acceptance_criteria\": [\n        \"Map F-pilot to build/launch instructions, deterministic fixture and retained trace/image references; record actual target, configuration and dependency compatibility.\",\n        \"A real fixed-step headless run reports expected time/tick observations and an inspected snapshot; explicitly distinguish workflow success from physical validation.\",\n        \"Submit decision-bearing observations in supported result fields, including a clearly labelled inconclusive physical claim to test review handling.\"\n      ],\n      \"plan_review\": {\n        \"question\": \"Does the pilot provide actual Bitloop observations and correctly limited claims, or do build incompatibility, missing diagnostic support or misleading evidence prevent further implementation?\"\n      },\n      \"input_artifacts\": [],\n      \"execution_kind\": \"work\"\n    },\n    {\n      \"id\": \"T-loop\",\n      \"parent_id\": null,\n      \"title\": \"Verify the saved execution-review-reload loop\",\n      \"goal\": \"Confirm that the pilot's evidence survives the management lifecycle.\",\n      \"context\": \"Consume T-pilot's saved terminal result and ensuing review, not merely its files. Use docs/MINDGRAPH_READINESS.md as historical risk context, not proof of current host defects. This is a supervised human check because host save/reload and disposition are outside simulation ownership.\",\n      \"components\": [\"C-app\"],\n      \"depends_on\": [\"T-pilot\"],\n      \"acceptance_criteria\": [\n        \"After save/reload, task identity, measurements, limitations, review question/disposition and referenced pilot files remain understandable.\",\n        \"Confirm dependency-ready selection and prerequisite handoff; record a minimal reproducer for any missing context, evidence loss or instruction conflict.\",\n        \"Authorize continuation only if the loop is usable; management repairs occur in their owning project, not the physics core.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-pilot\"],\n      \"execution_kind\": \"human_decision\"\n    },\n    {\n      \"id\": \"T-contract\",\n      \"parent_id\": null,\n      \"title\": \"Define shared physical interfaces and qualification fixtures\",\n      \"goal\": \"Establish the minimal common contract needed by independent numerical designs.\",\n      \"context\": \"Apply D-accounting, D-failure and A-scope. Define an early passive deformable chamber in surrounding fluid with translating/rotating and narrowing boundary cases. Reserve interfaces for finite transfer, fuel-limited stress and constrained sensing, but defer their detailed algorithms.\",\n      \"components\": [\"C-world\", \"C-boundary\", \"C-biology\"],\n      \"depends_on\": [\"T-loop\"],\n      \"acceptance_criteria\": [\n        \"F-contract specifies authoritative owners, stable IDs versus dense indices, units, area/mass conventions, exchange signs, state lifecycle, failure semantics and checkpoint-relevant state.\",\n        \"Specify fixture geometry, coefficients, minimum feature sizes and local/global oracles for equilibrium, free expansion, compression, sealed motion and support changes.\",\n        \"Propose explicit local/cumulative energy, deformation, volume, leakage and convergence budgets with rationale and refinement comparisons; mark unapproved values.\",\n        \"Define complete-work timing/memory boundaries and a passive rejection screen containing pressure solves, staging, safety checks, retries and representative difficult boundaries.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [],\n      \"execution_kind\": \"work\"\n    },\n    {\n      \"id\": \"T-design-mechanics\",\n      \"parent_id\": null,\n      \"title\": \"Design compliant mechanics and contact\",\n      \"goal\": \"Provide an implementable structural algorithm with measurable error and work.\",\n      \"context\": \"Use F-contract and D-representation. Select one concrete element/constraint formulation, integration method and supported contact treatment, including stiff supports and fiber stress interfaces; do not build a backend catalogue.\",\n      \"components\": [\"C-mechanics\"],\n      \"depends_on\": [\"T-contract\"],\n      \"acceptance_criteria\": [\n        \"F-mechanics-law defines constitutive laws, mass assignment, solver steps, contact/friction reactions, inversion prevention and bounded failure.\",\n        \"Worked translation, rotation, shear, compression/recovery and supported contact cases predict forces, deformation and energy/work accounts.\",\n        \"Document resolution limits, degeneracy metrics and how future actuator work enters without direct state mutation.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-contract\"],\n      \"execution_kind\": \"work\"\n    },\n    {\n      \"id\": \"T-design-contents\",\n      \"parent_id\": null,\n      \"title\": \"Design honest pressure-bearing compartments\",\n      \"goal\": \"Resolve chamber pressure, mass/inertia and wall work before implementation.\",\n      \"context\": \"Use F-contract. Well-mixed chemistry must not imply massless contents or invented circulation. Declare where this reduced representation is invalid and where a resolved interior is required.\",\n      \"components\": [\"C-contents\"],\n      \"depends_on\": [\"T-contract\"],\n      \"acceptance_criteria\": [\n        \"F-contents-law defines pressure versus actual area/inventory, stored energy, mass/inertia closure, wall forces and paired pressure work.\",\n        \"Worked translating/rotating chamber, free expansion, compression and connected finite-rate exchange examples close the applicable accounts.\",\n        \"Opening-transfer interface specifies amount, momentum and energy ownership; no instantaneous channel mixing or arbitrary ejection velocity.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-contract\"],\n      \"execution_kind\": \"work\"\n    },\n    {\n      \"id\": \"T-design-flow\",\n      \"parent_id\": null,\n      \"title\": \"Design conservative stationary flow\",\n      \"goal\": \"Specify the grid field and pressure algorithm independently of moving geometry.\",\n      \"context\": \"Use F-contract and D-representation. Choose one staggered/control-volume formulation, viscosity treatment, pressure solver/preconditioner and convergence criterion. Include environmental and explicitly resolved internal domains.\",\n      \"components\": [\"C-fluid\"],\n      \"depends_on\": [\"T-contract\"],\n      \"acceptance_criteria\": [\n        \"F-flow-law specifies stored quantities, fluxes, pressure nullspaces, boundary conditions, timestep restrictions and convergence/failure rules.\",\n        \"Worked uniform pressure, channel flow and momentum/viscous decay references include local errors and work accounting.\",\n        \"Specify disconnected regions, narrow supported passages and pressure iteration/memory instrumentation.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-contract\"],\n      \"execution_kind\": \"work\"\n    },\n    {\n      \"id\": \"T-design-boundary\",\n      \"parent_id\": null,\n      \"title\": \"Design sided moving geometry and cut-cell exchanges\",\n      \"goal\": \"Make geometry, displaced volume and pressure work discretely compatible.\",\n      \"context\": \"Consume all three numerical laws. Select one explicit small-cell stabilization strategy that preserves sided barrier topology and amounts; rejection is preferable to silent wall removal.\",\n      \"components\": [\"C-boundary\", \"C-fluid\", \"C-mechanics\", \"C-contents\"],\n      \"depends_on\": [\"T-contract\", \"T-design-mechanics\", \"T-design-contents\", \"T-design-flow\"],\n      \"acceptance_criteria\": [\n        \"F-boundary-law defines cut geometry, swept-volume fluxes, side connectivity, traction/work pairing and conservative appearance/disappearance of geometric support.\",\n        \"Worked moving corner, translating thin membrane, narrow passage and freely expanding chamber cases reconcile local geometry and inventories.\",\n        \"Define small-cell limits, continuity tests, collision/no-flux agreement and bounded unsupported-condition outcomes.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-contract\", \"F-mechanics-law\", \"F-contents-law\", \"F-flow-law\"],\n      \"execution_kind\": \"work\"\n    },\n    {\n      \"id\": \"T-reconcile\",\n      \"parent_id\": null,\n      \"title\": \"Reconcile the coupled advancement and experiment specification\",\n      \"goal\": \"Produce an implementable passive work package and predeclared gates.\",\n      \"context\": \"Reconcile existing mechanism designs rather than redesigning the whole engine. Choose substep ordering, two-way solve convergence and staging ownership; reserve finite transfer and actuator interfaces.\",\n      \"components\": [\"C-world\", \"C-boundary\"],\n      \"depends_on\": [\"T-contract\", \"T-design-mechanics\", \"T-design-contents\", \"T-design-flow\", \"T-design-boundary\"],\n      \"acceptance_criteria\": [\n        \"F-passive-spec resolves all units, signs, duplicated mass risks, geometry timing, boundary conditions, pressure/force exchange and rollback across mechanisms.\",\n        \"Freeze proposed passive configurations, local and global tolerances, refinement comparisons, quality-matched full-cost rejection budgets and horizon rationale.\",\n        \"Specify failure injection and low-frequency passive-motion tests that detect gain, excess damping, leakage and collapsed features.\",\n        \"Identify expected implementation paths and test locations without adding speculative subsystem frameworks.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-contract\", \"F-mechanics-law\", \"F-contents-law\", \"F-flow-law\", \"F-boundary-law\"],\n      \"execution_kind\": \"work\"\n    },\n    {\n      \"id\": \"T-approve\",\n      \"parent_id\": null,\n      \"title\": \"Approve the bounded numerical work package\",\n      \"goal\": \"Obtain explicit agreement on scope, approximation budgets and rejection conditions.\",\n      \"context\": \"Approval is not solver adoption. Confirm A-scope and A-budgets, including the distinction between laboratory delivery and later rich-world acceptance.\",\n      \"components\": [\"C-world\"],\n      \"depends_on\": [\"T-reconcile\"],\n      \"acceptance_criteria\": [\n        \"Human approves or requests changes to F-passive-spec, proposed tolerances, supported resolution, complete-cost budgets and initial scope.\",\n        \"Unresolved requirements or rejected budgets block implementation; no worker may relax them to obtain a pass.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-passive-spec\"],\n      \"execution_kind\": \"human_decision\"\n    },\n    {\n      \"id\": \"T-world\",\n      \"parent_id\": null,\n      \"title\": \"Implement authoritative state and transactional advancement\",\n      \"goal\": \"Provide a testable core lifecycle without simulation dependence on Bitloop Scene.\",\n      \"context\": \"Implement D-boundary and D-failure using F-passive-spec. Capability bitloop supplies build integration, not physics. Keep compact hot storage and reusable staging, with measured allocation/copy costs.\",\n      \"components\": [\"C-world\"],\n      \"depends_on\": [\"T-approve\", \"T-reconcile\"],\n      \"acceptance_criteria\": [\n        \"F-world implements IDs, state ownership, fixed requested-interval advancement, exchange accumulation and bounded staging/retries.\",\n        \"Focused tests inject nonfinite state, solver failure and retry exhaustion; committed state and actual time remain unchanged on failed intervals.\",\n        \"Build the smallest relevant target and measure empty/staged advancement overhead without claiming coupled performance.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-passive-spec\"],\n      \"execution_kind\": \"work\"\n    },\n    {\n      \"id\": \"T-mechanics\",\n      \"parent_id\": null,\n      \"title\": \"Implement structural mechanics and contact references\",\n      \"goal\": \"Deliver tested passive tissue, fibers and stiff support mechanics.\",\n      \"context\": \"Implement F-mechanics-law under the reconciled schedule. Use capability simulation-health for degeneracy and energy diagnostics; keep durable validity checks in core.\",\n      \"components\": [\"C-mechanics\"],\n      \"depends_on\": [\"T-world\", \"T-design-mechanics\", \"T-reconcile\"],\n      \"acceptance_criteria\": [\n        \"F-mechanics maps production implementation and focused tests to the approved constitutive/contact laws.\",\n        \"Translation, rotation, shear, compression/recovery and contact tests quantify local deformation, paired reactions and numerical work across timestep/resolution comparisons.\",\n        \"Degenerate/inverted or unsupported contact cases fail without invalid commit or silent topology deletion.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-world\", \"F-mechanics-law\", \"F-passive-spec\"],\n      \"execution_kind\": \"work\"\n    },\n    {\n      \"id\": \"T-contents\",\n      \"parent_id\": null,\n      \"title\": \"Implement chamber inventories and pressure mechanics\",\n      \"goal\": \"Deliver pressure-bearing reduced contents with explicit ownership.\",\n      \"context\": \"Implement F-contents-law against F-world; use prescribed geometry fixtures before full coupling.\",\n      \"components\": [\"C-contents\"],\n      \"depends_on\": [\"T-world\", \"T-design-contents\", \"T-reconcile\"],\n      \"acceptance_criteria\": [\n        \"F-contents implements geometry-based pressure, inventory, mass/inertia and paired wall-work interfaces.\",\n        \"Worked law references pass quantitatively, including translating/rotating contents, expansion and compression.\",\n        \"Invalid chamber geometry or inventory fails transactionally; unresolved spatial behavior is reported as unsupported.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-world\", \"F-contents-law\", \"F-passive-spec\"],\n      \"execution_kind\": \"work\"\n    },\n    {\n      \"id\": \"T-flow\",\n      \"parent_id\": null,\n      \"title\": \"Implement stationary conservative flow and pressure solves\",\n      \"goal\": \"Establish a tested field solver before moving-boundary integration.\",\n      \"context\": \"Implement F-flow-law, including instrumentation of complete field work rather than force-kernel timing.\",\n      \"components\": [\"C-fluid\"],\n      \"depends_on\": [\"T-world\", \"T-design-flow\", \"T-reconcile\"],\n      \"acceptance_criteria\": [\n        \"F-flow implements field state, fluxes, viscosity, pressure solver and declared boundary conditions.\",\n        \"Uniform pressure, channel flow, disconnected-domain and decay tests report local/global residuals, pressure iterations and refinement behavior.\",\n        \"Nonconvergence and unsupported passages preserve committed state; timings include field preparation and reductions.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-world\", \"F-flow-law\", \"F-passive-spec\"],\n      \"execution_kind\": \"work\"\n    },\n    {\n      \"id\": \"T-boundary\",\n      \"parent_id\": null,\n      \"title\": \"Implement moving geometry and sided barriers\",\n      \"goal\": \"Deliver tested geometric conservation and wall-exchange operators.\",\n      \"context\": \"Implement F-boundary-law with prescribed moving structures against established field and mechanical interfaces. Full two-way coupled trajectories belong to T-passive.\",\n      \"components\": [\"C-boundary\"],\n      \"depends_on\": [\"T-mechanics\", \"T-contents\", \"T-flow\", \"T-design-boundary\", \"T-reconcile\"],\n      \"acceptance_criteria\": [\n        \"F-boundary implements sided cut geometry, swept-volume fluxes, small-cell treatment and paired tractions/work.\",\n        \"Prescribed translation, rotation, moving corners and support transitions satisfy local volume/pressure and sealed-barrier criteria.\",\n        \"No interpolation path mixes opposite sides of a membrane; minimum-feature violations are explicit and transactional.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-mechanics\", \"F-contents\", \"F-flow\", \"F-boundary-law\", \"F-passive-spec\"],\n      \"execution_kind\": \"work\"\n    },\n    {\n      \"id\": \"T-passive\",\n      \"parent_id\": null,\n      \"title\": \"Integrate and qualify the passive coupled foundation\",\n      \"goal\": \"Reject unaffordable or physically inconsistent coupling before biology.\",\n      \"context\": \"Integrate established components only. Use capabilities traces and simulation-health, plus snapshots-checkpoints for visual correlation. Nutrient reactions and actuation are intentionally absent: this gate tests passive geometry/pressure/mechanics compatibility, not final organism adoption.\",\n      \"components\": [\"C-world\", \"C-mechanics\", \"C-contents\", \"C-fluid\", \"C-boundary\", \"C-app\"],\n      \"depends_on\": [\"T-world\", \"T-mechanics\", \"T-contents\", \"T-flow\", \"T-boundary\", \"T-reconcile\"],\n      \"acceptance_criteria\": [\n        \"F-passive contains runnable coupled fixtures, retained oracles and compact qualification findings with actual commands, hardware, precision, workers, dt and source identity.\",\n        \"Measure uniform-pressure equilibrium, local free expansion, compression/recovery, translating/rotating sealed boundaries, narrow passages and support transitions under two-way coupling.\",\n        \"Measure local volume, barrier leakage, force/work pairing, passive drift and weak-motion damping over predeclared relaxation/contact cycles and refinement comparisons.\",\n        \"Measure full intervals including geometry reconstruction, pressure iterations, staging, safety scans and all retries; report mean, tails, maximum latency and memory.\",\n        \"Negative or inconclusive outcomes are explicitly recorded and do not authorize dependent biological work.\"\n      ],\n      \"plan_review\": {\n        \"question\": \"Do the passive coupled trajectories meet the approved local geometry/transport, energy, barrier and complete-cost budgets? Reject the candidate on local errors, sustained passive gain, collapsing support, timestep collapse or excessive whole-step cost; incomplete horizons or unrepresentative geometry are inconclusive.\"\n      },\n      \"input_artifacts\": [\"F-world\", \"F-mechanics\", \"F-contents\", \"F-flow\", \"F-boundary\", \"F-passive-spec\"],\n      \"execution_kind\": \"work\"\n    },\n    {\n      \"id\": \"T-design-transport\",\n      \"parent_id\": null,\n      \"title\": \"Design finite species transport and metabolic exchanges\",\n      \"goal\": \"Define the downstream conservative transport and resource laws after passive feasibility.\",\n      \"context\": \"Use accepted passive interfaces. Choose a small declared nutrient/fuel/waste/signal set with explicit mass/energy meaning, positivity treatment and finite channel/permeability laws. Thermal transport and rupture/repair implementation remain later scope.\",\n      \"components\": [\"C-fluid\", \"C-contents\", \"C-biology\"],\n      \"depends_on\": [\"T-passive\", \"T-contract\"],\n      \"acceptance_criteria\": [\n        \"F-transport-law defines field advection/diffusion, chamber/channel/permeability transfers and local reaction stoichiometry/rates with unique inventory ownership.\",\n        \"Worked advection, diffusion, two-chamber equilibration and membrane transport examples specify local concentration accuracy, positivity and conservation oracles.\",\n        \"Specify chemical energy consumption, actuator work limits and numerical-loss exclusion; define gradient-preservation thresholds before comparison.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-passive\", \"F-contract\"],\n      \"execution_kind\": \"work\"\n    },\n    {\n      \"id\": \"T-transport\",\n      \"parent_id\": null,\n      \"title\": \"Implement conservative transport and finite exchange\",\n      \"goal\": \"Make substances take physically meaningful routes through moving organisms.\",\n      \"context\": \"Implement F-transport-law using accepted sided geometry. Use capabilities traces and simulation-health for transported fields; totals alone are insufficient.\",\n      \"components\": [\"C-fluid\", \"C-contents\", \"C-boundary\"],\n      \"depends_on\": [\"T-design-transport\", \"T-passive\"],\n      \"acceptance_criteria\": [\n        \"F-transport supplies field/chamber species ownership and finite-rate transfer APIs with focused tests.\",\n        \"Advection/diffusion references quantify local error and numerical diffusion; connected chambers do not mix instantaneously.\",\n        \"Moving intact impermeable membranes block species; permeable interfaces have measured paired flux and no negative inventories.\",\n        \"Transport failure rolls back the whole attempted interval, including geometry and mechanics.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-transport-law\", \"F-passive\"],\n      \"execution_kind\": \"work\"\n    },\n    {\n      \"id\": \"T-design-active\",\n      \"parent_id\": null,\n      \"title\": \"Specify resource-limited activity and active proof fixtures\",\n      \"goal\": \"Define implementable controllers and a predeclared active acceptance campaign.\",\n      \"context\": \"Use local sensing only, actuator requests rather than arbitrary state writes, and the established reaction/exchange laws. The active proof must join tissue, chamber, moving fluid, nutrient exchange and fuel-limited contraction; useful motion and measured pumping work are both required.\",\n      \"components\": [\"C-biology\", \"C-mechanics\"],\n      \"depends_on\": [\"T-design-transport\", \"T-passive\"],\n      \"acceptance_criteria\": [\n        \"F-active-spec defines local sensing bounds, deterministic controller state, fuel-to-work coupling, reaction updates and equal costs for authored constructions.\",\n        \"Specify cyclic isolation controls, fuel depletion/refeeding tests, a locomoting body and a chamber pump with finite transport against load.\",\n        \"Propose quantitative useful-motion, delivered nutrient, pump-work and weak-gradient criteria, active-cycle horizons and quality-matched complete-cost limits.\",\n        \"Freeze the proposed laboratory fixture: 16 interacting organisms, up to 128 vertices, two chambers and 16 actuators each, and 128 by 128 active environmental cells.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-transport-law\", \"F-passive\"],\n      \"execution_kind\": \"work\"\n    },\n    {\n      \"id\": \"T-approve-active\",\n      \"parent_id\": null,\n      \"title\": \"Approve active and laboratory acceptance budgets\",\n      \"goal\": \"Freeze behavioral and performance thresholds before measuring candidates.\",\n      \"context\": \"This approves test requirements, not successful behavior. Preserve the proposed one simulated second per wall-clock second laboratory target and record the actual reference hardware requirements.\",\n      \"components\": [\"C-biology\", \"C-world\"],\n      \"depends_on\": [\"T-design-active\"],\n      \"acceptance_criteria\": [\n        \"Human agrees to F-active-spec's physical thresholds, supported quality, complete timing/memory definitions and justified endurance horizon.\",\n        \"Any changed requirement is explicit; failure cannot be repaired by silently reducing organism activity, feature size or quality.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-active-spec\"],\n      \"execution_kind\": \"human_decision\"\n    },\n    {\n      \"id\": \"T-active\",\n      \"parent_id\": null,\n      \"title\": \"Implement constrained controllers and fuel-limited fibers\",\n      \"goal\": \"Deliver common local biological activity without organism-specific physics.\",\n      \"context\": \"Implement approved F-active-spec and F-transport-law. A controller cannot choose solver settings, teleport inventory or use global privileged observations.\",\n      \"components\": [\"C-biology\", \"C-mechanics\"],\n      \"depends_on\": [\"T-approve-active\", \"T-design-active\", \"T-design-transport\", \"T-transport\"],\n      \"acceptance_criteria\": [\n        \"F-active implements local sensing, deterministic controller advancement, reaction accounting and actuator work requests.\",\n        \"Tests show fuel exhaustion limits contraction, replenishment restores it, elapsed-time updates are correct and unavailable fuel cannot be overspent.\",\n        \"Chemical expenditure, mechanical work, physical dissipation and numerical residual remain separately observable.\",\n        \"Scripted cyclic requests and deterministic controllers use the same physical interfaces.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-active-spec\", \"F-transport-law\", \"F-transport\"],\n      \"execution_kind\": \"work\"\n    },\n    {\n      \"id\": \"T-active-proof\",\n      \"parent_id\": null,\n      \"title\": \"Qualify the complete inexpensive active organism\",\n      \"goal\": \"Decide whether the foundation enables useful resource-limited motion and pumping.\",\n      \"context\": \"Use capabilities traces, simulation-health and snapshots-checkpoints. Qualify complete coupled trajectories at representative complexity, not an isolated actuator or transport kernel.\",\n      \"components\": [\"C-world\", \"C-biology\", \"C-app\"],\n      \"depends_on\": [\"T-active\", \"T-transport\", \"T-design-active\", \"T-passive\"],\n      \"acceptance_criteria\": [\n        \"F-active-proof provides runnable locomotion and loaded pump fixtures with nutrient uptake, fuel expenditure and finite transfers.\",\n        \"Meet approved motion, pump-work, gradient, local conservation and energy budgets across resolution/timestep comparisons and fuel/no-fuel controls.\",\n        \"Run the approved activity/transport/relaxation horizons, inspecting cumulative drift, feature degeneration and passive-control propulsion.\",\n        \"Report complete cost including sensing, reactions, field work, coupling, retries and safety; preserve failed configurations and uncertainty.\"\n      ],\n      \"plan_review\": {\n        \"question\": \"Does the complete active proof preserve useful locomotion, loaded pumping, nutrient transport and resource limitation at the approved quality and cost? Reject free actuation, leakage-dependent behavior, disappearing gradients or unaffordable complete intervals; incomplete cycle coverage cannot establish adoption.\"\n      },\n      \"input_artifacts\": [\"F-active\", \"F-transport\", \"F-active-spec\", \"F-passive\"],\n      \"execution_kind\": \"work\"\n    },\n    {\n      \"id\": \"T-adopt\",\n      \"parent_id\": null,\n      \"title\": \"Accept or reject prototype adoption\",\n      \"goal\": \"Separate adoption of the coupled prototype from laboratory expansion.\",\n      \"context\": \"Consume actual active and passive qualification findings and their review dispositions. A successful experiment execution is not a physical pass.\",\n      \"components\": [\"C-world\"],\n      \"depends_on\": [\"T-active-proof\", \"T-passive\"],\n      \"acceptance_criteria\": [\n        \"Human explicitly accepts the supported validity range and prototype evidence or rejects/requests investigation.\",\n        \"Laboratory expansion proceeds only after favorable physical findings and explicit adoption; requirements remain unchanged.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-active-proof\", \"F-passive\"],\n      \"execution_kind\": \"human_decision\"\n    },\n    {\n      \"id\": \"T-lab\",\n      \"parent_id\": null,\n      \"title\": \"Build the shared interactive laboratory\",\n      \"goal\": \"Compose materially different organisms in one interacting habitat.\",\n      \"context\": \"Use accepted common interfaces, not swimming/feeding/predator physics. Implement crawling contractile, swimming membrane and chambered pumping constructions, terrain/obstacles, shared flow, nutrient patches, waste and signals. Use bitloop and input capabilities for shell controls and replay; respect client-space input semantics.\",\n      \"components\": [\"C-biology\", \"C-app\"],\n      \"depends_on\": [\"T-adopt\", \"T-active-proof\", \"T-design-active\"],\n      \"acceptance_criteria\": [\n        \"F-lab maps construction fixtures, scene configuration and thin-shell rendering/input integration to production paths.\",\n        \"All three constructions demonstrate their behavior from common material/controller interfaces, with explicitly chosen chamber versus resolved interior representations.\",\n        \"The 16-organism fixture includes shared flow, contact, resource competition, pumping and permeable exchange; every organism senses, consumes fuel and actuates.\",\n        \"Input replay and inspected images correlate with semantic state; multiple viewports and render-rate changes do not alter advancement.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-active-proof\", \"F-active-spec\"],\n      \"execution_kind\": \"work\"\n    },\n    {\n      \"id\": \"T-recording\",\n      \"parent_id\": null,\n      \"title\": \"Implement reproducible recording and checkpoint continuation\",\n      \"goal\": \"Make bounded experiments restartable and recordable through existing Bitloop facilities.\",\n      \"context\": \"Use capabilities traces and snapshots-checkpoints. Current hooks are unimplemented; serialization must cover authoritative state, controller state, RNG, configuration and actual time, not raw memory.\",\n      \"components\": [\"C-app\", \"C-world\"],\n      \"depends_on\": [\"T-lab\"],\n      \"acceptance_criteria\": [\n        \"F-recording implements versioned project-owned save/load adapters and documented seeded launch/recording configurations.\",\n        \"Uninterrupted versus restored active runs match declared fingerprints/tolerances, including pending schedules and controller phases.\",\n        \"Incompatible/corrupt checkpoints fail without altering valid state; deterministic replay is demonstrated on the declared execution configuration.\",\n        \"Recording captures are inspected and paired with semantic traces; I/O and rendering overhead are measured separately.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-lab\"],\n      \"execution_kind\": \"work\"\n    },\n    {\n      \"id\": \"T-lab-qualify\",\n      \"parent_id\": null,\n      \"title\": \"Qualify laboratory throughput and behavioral endurance\",\n      \"goal\": \"Measure the complete delivered workload at approved quality.\",\n      \"context\": \"Use simulation-health, traces and snapshots-checkpoints. The laboratory target is at least 1 simulated second per wall-clock second; this is not the rich-world three-frame target or its ten-minute acceptance. Use the preapproved laboratory horizon and extend while drift remains unresolved.\",\n      \"components\": [\"C-world\", \"C-app\", \"C-biology\"],\n      \"depends_on\": [\"T-lab\", \"T-recording\", \"T-design-active\"],\n      \"acceptance_criteria\": [\n        \"F-lab-qualified records actual hardware/compiler/build/precision/workers/load, fixed dt, simulated time, seeds, cycle counts and stopping rationale.\",\n        \"Measure complete calculated intervals and 0.02-second output frames including every substep/retry, state preparation, contact, controls, pressure, transport, safety and commit.\",\n        \"Report mean, p95, p99, maximum latency, simulation memory, work counts and user-facing recording throughput across repeated windows containing contact/activity bursts.\",\n        \"Verify local/global balances, no forbidden passage, stable features, fuel-limited behavior and preserved gradients over the approved horizon and refinement comparisons.\",\n        \"Demonstrate standalone configuration/build/run from documented project dependencies; no sibling runtime dependencies or framework edits are hidden.\"\n      ],\n      \"plan_review\": {\n        \"question\": \"Does the interacting laboratory meet its approved real-time target and physical/endurance budgets without sleeping active organisms or omitting work? A throughput miss, recurring stalls, growing work per organism or unresolved drift blocks delivery acceptance and requires an explicit design or scope decision.\"\n      },\n      \"input_artifacts\": [\"F-lab\", \"F-recording\", \"F-active-spec\"],\n      \"execution_kind\": \"work\"\n    },\n    {\n      \"id\": \"T-deliver\",\n      \"parent_id\": null,\n      \"title\": \"Clean and package the qualified laboratory\",\n      \"goal\": \"Leave one coherent production foundation and reproducible acceptance path.\",\n      \"context\": \"Preserve useful counterexamples and oracles; remove the pilot observable, disposable probes and superseded candidate implementations. Keep observational diagnostics behind BITLOOP_DEV_MODE and core safety checks independent of management tooling.\",\n      \"components\": [\"C-world\", \"C-app\"],\n      \"depends_on\": [\"T-lab-qualify\", \"T-recording\"],\n      \"acceptance_criteria\": [\n        \"F-delivery identifies final source/build/configuration paths, launch examples, supported units/resolution/validity range and known unsupported conditions.\",\n        \"No backend menu, temporary compatibility layer, predecessor dependency or MindGraph logging SDK remains.\",\n        \"After cleanup rerun relevant regression/build checks and a representative recorded interval; demonstrate checkpoint continuation remains valid.\",\n        \"Document the laboratory's actual measured limits and explicitly distinguish unimplemented rich-world, damage/repair, thermal, growth and evolutionary ambitions.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-lab-qualified\", \"F-recording\"],\n      \"execution_kind\": \"work\"\n    },\n    {\n      \"id\": \"T-accept\",\n      \"parent_id\": null,\n      \"title\": \"Accept the initial laboratory delivery\",\n      \"goal\": \"Obtain user acceptance without implying approval of later scale or features.\",\n      \"context\": \"Review the delivered laboratory and measured limitations, not only successful task status.\",\n      \"components\": [\"C-app\"],\n      \"depends_on\": [\"T-deliver\", \"T-lab-qualify\"],\n      \"acceptance_criteria\": [\n        \"Human accepts or requests changes to the runnable laboratory, recordings and supported physical/performance claims.\",\n        \"Any rich-world expansion remains a separate approved plan with its original full workload, tail, memory and endurance requirements.\"\n      ],\n      \"plan_review\": null,\n      \"input_artifacts\": [\"F-delivery\", \"F-lab-qualified\"],\n      \"execution_kind\": \"human_decision\"\n    }\n  ],\n  \"questions\": [],\n  \"artifacts\": [\n    {\n      \"id\": \"F-pilot\",\n      \"title\": \"Reproducible Bitloop diagnostic pilot\",\n      \"description\": \"Project-owned deterministic fixture, build/launch instructions and retained trace/image references; establishes wiring only.\",\n      \"produced_by\": \"T-pilot\"\n    },\n    {\n      \"id\": \"F-contract\",\n      \"title\": \"Shared physical and state contract\",\n      \"description\": \"Located specification of owners, units, interfaces, state lifecycle, passive fixtures and proposed budgets.\",\n      \"produced_by\": \"T-contract\"\n    },\n    {\n      \"id\": \"F-mechanics-law\",\n      \"title\": \"Mechanics algorithm and reference cases\",\n      \"description\": \"Implementable constitutive/contact law, solver, failure rules and worked mechanical oracles.\",\n      \"produced_by\": \"T-design-mechanics\"\n    },\n    {\n      \"id\": \"F-contents-law\",\n      \"title\": \"Compartment algorithm and reference cases\",\n      \"description\": \"Geometry-based pressure, mass/inertia, energy/work and transfer contract with validity limits.\",\n      \"produced_by\": \"T-design-contents\"\n    },\n    {\n      \"id\": \"F-flow-law\",\n      \"title\": \"Stationary flow algorithm and reference cases\",\n      \"description\": \"Control-volume layout, flux/pressure algorithm, boundary conditions, convergence and quantitative references.\",\n      \"produced_by\": \"T-design-flow\"\n    },\n    {\n      \"id\": \"F-boundary-law\",\n      \"title\": \"Moving-boundary algorithm and reference cases\",\n      \"description\": \"Sided cut geometry, small-cell treatment, swept volumes, traction/work exchanges and support-transition oracles.\",\n      \"produced_by\": \"T-design-boundary\"\n    },\n    {\n      \"id\": \"F-passive-spec\",\n      \"title\": \"Reconciled passive implementation package\",\n      \"description\": \"Complete coupled schedule, authoritative exchanges, staging/failure design and predeclared qualification configurations/budgets.\",\n      \"produced_by\": \"T-reconcile\"\n    },\n    {\n      \"id\": \"F-world\",\n      \"title\": \"Authoritative core lifecycle\",\n      \"description\": \"Implemented state/ID/exchange interfaces and transactional requested-interval advancement with focused failure tests.\",\n      \"produced_by\": \"T-world\"\n    },\n    {\n      \"id\": \"F-mechanics\",\n      \"title\": \"Tested structural mechanics\",\n      \"description\": \"Production tissue/fiber/support/contact implementation and located focused reference tests.\",\n      \"produced_by\": \"T-mechanics\"\n    },\n    {\n      \"id\": \"F-contents\",\n      \"title\": \"Tested pressure-bearing contents\",\n      \"description\": \"Production compartment inventories and geometry-coupled mass/pressure/work interfaces with reference tests.\",\n      \"produced_by\": \"T-contents\"\n    },\n    {\n      \"id\": \"F-flow\",\n      \"title\": \"Tested stationary field solver\",\n      \"description\": \"Production field/pressure implementation, convergence instrumentation and reference tests.\",\n      \"produced_by\": \"T-flow\"\n    },\n    {\n      \"id\": \"F-boundary\",\n      \"title\": \"Tested moving geometry operators\",\n      \"description\": \"Production sided-boundary exchanges and prescribed-motion local-conservation tests.\",\n      \"produced_by\": \"T-boundary\"\n    },\n    {\n      \"id\": \"F-passive\",\n      \"title\": \"Passive coupled qualification package\",\n      \"description\": \"Integrated passive fixtures, reproducible configurations, retained numerical/cost findings and counterexamples; does not itself convey adoption.\",\n      \"produced_by\": \"T-passive\"\n    },\n    {\n      \"id\": \"F-transport-law\",\n      \"title\": \"Transport and reaction specification\",\n      \"description\": \"Finite species-transfer algorithms, stoichiometric/energy laws, positivity rules and local-field references.\",\n      \"produced_by\": \"T-design-transport\"\n    },\n    {\n      \"id\": \"F-transport\",\n      \"title\": \"Tested conservative transport\",\n      \"description\": \"Moving-field species transport, finite chamber/permeability exchange APIs and local/global tests.\",\n      \"produced_by\": \"T-transport\"\n    },\n    {\n      \"id\": \"F-active-spec\",\n      \"title\": \"Active proof and laboratory specification\",\n      \"description\": \"Controller/actuation algorithms, organism fixtures and proposed behavioral, performance and horizon budgets requiring explicit approval.\",\n      \"produced_by\": \"T-design-active\"\n    },\n    {\n      \"id\": \"F-active\",\n      \"title\": \"Tested local activity implementation\",\n      \"description\": \"Deterministic constrained controllers, reactions and fuel-limited actuator interfaces with depletion/refeeding tests.\",\n      \"produced_by\": \"T-active\"\n    },\n    {\n      \"id\": \"F-active-proof\",\n      \"title\": \"Complete active qualification package\",\n      \"description\": \"Locomotion and loaded-pump fixtures with nutrient/fuel coupling, physical/refinement findings and complete-cost measurements.\",\n      \"produced_by\": \"T-active-proof\"\n    },\n    {\n      \"id\": \"F-lab\",\n      \"title\": \"Interactive shared laboratory\",\n      \"description\": \"Three common-rule organism constructions, interacting 16-organism habitat, thin application integration and replayable interactions.\",\n      \"produced_by\": \"T-lab\"\n    },\n    {\n      \"id\": \"F-recording\",\n      \"title\": \"Recording and restart implementation\",\n      \"description\": \"Versioned checkpoint adapters, seeded recording configurations and reproducible continuation comparisons.\",\n      \"produced_by\": \"T-recording\"\n    },\n    {\n      \"id\": \"F-lab-qualified\",\n      \"title\": \"Laboratory qualification package\",\n      \"description\": \"Reproducible full-workload timing, memory, physical quality and endurance findings with limitations and retained raw references.\",\n      \"produced_by\": \"T-lab-qualify\"\n    },\n    {\n      \"id\": \"F-delivery\",\n      \"title\": \"Clean initial Substrate delivery\",\n      \"description\": \"Runnable documented laboratory, supported validity range, build/record/restart instructions and retained regression oracles without obsolete candidates.\",\n      \"produced_by\": \"T-deliver\"\n    }\n  ]\n}",
