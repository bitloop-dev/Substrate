                    "raw_response": "{\n  \"action_id\": \"classify_plan::\",\n  \"reason\": \"Propose roles to resolve the execution-role prerequisite: design and foundation are organizational groups, work-package approval requires a human, and the remaining tasks perform concrete work or evidence checks. Roles remain subject to human acceptance.\",\n  \"question\": \"\",\n  \"task_kinds\": [\n    {\"task_id\":\"T-actuation-design\",\"execution_kind\":\"work\"},\n    {\"task_id\":\"T-actuators\",\"execution_kind\":\"work\"},\n    {\"task_id\":\"T-adoption\",\"execution_kind\":\"work\"},\n    {\"task_id\":\"T-approve\",\"execution_kind\":\"human_decision\"},\n    {\"task_id\":\"T-bootstrap\",\"execution_kind\":\"work\"},\n    {\"task_id\":\"T-budgets\",\"execution_kind\":\"work\"},\n    {\"task_id\":\"T-chambers\",\"execution_kind\":\"work\"},\n    {\"task_id\":\"T-contact\",\"execution_kind\":\"work\"},\n    {\"task_id\":\"T-contact-design\",\"execution_kind\":\"work\"},\n    {\"task_id\":\"T-contents-design\",\"execution_kind\":\"work\"},\n    {\"task_id\":\"T-core\",\"execution_kind\":\"work\"},\n    {\"task_id\":\"T-design\",\"execution_kind\":\"group\"},\n    {\"task_id\":\"T-field\",\"execution_kind\":\"work\"},\n    {\"task_id\":\"T-field-design\",\"execution_kind\":\"work\"},\n    {\"task_id\":\"T-foundation\",\"execution_kind\":\"group\"},\n    {\"task_id\":\"T-geometry\",\"execution_kind\":\"work\"},\n    {\"task_id\":\"T-geometry-design\",\"execution_kind\":\"work\"},\n    {\"task_id\":\"T-handoff\",\"execution_kind\":\"work\"},\n    {\"task_id\":\"T-loop-confirm\",\"execution_kind\":\"work\"},\n    {\"task_id\":\"T-mechanics-design\",\"execution_kind\":\"work\"},\n    {\"task_id\":\"T-moving-field\",\"execution_kind\":\"work\"},\n    {\"task_id\":\"T-passive\",\"execution_kind\":\"work\"},\n    {\"task_id\":\"T-passive-coupling\",\"execution_kind\":\"work\"},\n    {\"task_id\":\"T-passive-qualification\",\"execution_kind\":\"work\"},\n    {\"task_id\":\"