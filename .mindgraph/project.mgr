                                "name": "Resolved fluid and transport",
                                "responsibility": "Own grid control-volume inventories, momentum, pressure solve and species transport in environmental or explicitly resolved internal fluid."
                            },
                            {
                                "id": "C-boundary",
                                "name": "Geometry and exchange coupling",
                                "responsibility": "Derive cut geometry and sided barriers from authoritative structures; reconcile swept volumes, fluxes, pressure forces, work and support transitions without owning duplicate inventory."
                            },
                            {
                                "id": "C-biology",
                                "name": "Construction and local activity",
                                "responsibility": "Compose organisms using common material interfaces; own deterministic local controllers and reaction rules that request resource-limited actuation and transfers."
                            },
                            {
                                "id": "C-app",
                                "name": "Bitloop application and experiment adapters",
                                "responsibility": "Keep Substrate.h/.cpp thin; own configuration, rendering, camera/input, recording, semantic trace adapters and explicit checkpoint serialization."
                            }
                        ],
                        "decisions": [
                            {
                                "decision": "Keep physics independent of Scene, UI, rendering, input, scenario names, trace formatting and file output.",
                                "id": "D-boundary",
                                "rationale": "Preserves independent numerical tests, authoritative ownership and a thin existing application shell."
                            },
                            {
                                "decision": "Investigate compliant connected elements, well-mixed chambers and conservative grid flow with explicit sided moving barriers.",
                                "id": "D-representation",
                                "rationale": "Tests the preferred affordable representation while exposing small-cell, pressure-solve and two-way coupling risks before biological expansion."
                            },
                            {
                                "decision": "Use area-based two-dimensional units and explicit paired amount, impulse and work exchanges; distinguish physical dissipation from numerical residual.",
                                "id": "D-accounting",
                                "rationale": "Prevents geometry/inventory disagreement, duplicate ownership and numerical error becoming usable biological energy."
                            },
                            {
                                "decision": "Advance requested intervals with bounded staging/retries; never skip time, erase unsupported features or silently freeze active dynamics.",
                                "id": "D-failure",
                                "rationale": "Transactional validity and honest failure are hard requirements, but full deep copies at every substep are not prescribed."
                            },
                            {
                                "decision": "Qualify passive coupling first, then nutrient/fuel-limited active behavior, then interacting laboratory scale.",
                                "id": "D-gates",
                                "rationale": "Passive moving-boundary failure must be discovered before transport and control investment. Active behavior is still mandatory before foundation adoption."
                            },
                            {
                                "decision": "Defer automatic representation switching, adaptive refinement, general fracture/remeshing, growth/repair/reproduction, evolution, thermal/phase/electrical models and rich-world scale.",
                                "id": "D-later",
                                "rationale": "These remain vision requirements for later work packages, not prerequisites or promised features of the bounded initial laboratory."
                            }
