                                "lines": "1: #pragma once\r\n2: #include <bitloop.h>\r\n3: \r\n4: SIM_BEG;\r\n5: \r\n6: using namespace bl;\r\n7: \r\n8: struct Substrate_Scene : public Scene<Substrate_Scene>\r\n9: {\r\n10:     CameraInfo       camera;\r\n11:     CameraNavigator  navigator;\r\n12: \r\n13:     /// ─────── Variables ───────\r\n14: \r\n15: \r\n16:     /// ─────── Methods ───────\r\n17: \r\n18: \r\n19:     /// ─────── Launch config ───────\r\n20:     struct Config {};\r\n21: \r\n22:     Substrate_Scene(Config& info [[maybe_unused]])\r\n23:     {}\r\n24: \r\n25:     struct UI : BufferedInterfaceModel\r\n26:     {\r\n27:         using BufferedInterfaceModel::BufferedInterfaceModel;\r\n28:         void sidebar() override;\r\n29:         // void overlay() override; // ImGui viewport overlay\r\n30: \r\n31:         /// ─────── Your UI-only variables ───────\r\n32: \r\n33:     };\r\n34: \r\n35:     /// ─────── Scene methods ───────\r\n36:     void sceneStart() override;\r\n37:     void sceneMounted(Viewport* viewport) override;\r\n38:     void sceneUnmounted(Viewport* viewport) override;\r\n39:     void sceneDestroy() override;\r\n40:     void sceneProcess() override;\r\n41: \r\n42:     /// ─────── Viewport methods ───────\r\n43:     void viewportProcess(Viewport* ctx, double dt) override;\r\n44:     void viewportDraw(Viewport* ctx) const override;\r\n45: \r\n46:     /// ─────── Input handling ───────\r\n47:     void onEvent(Event e) override; // receives all event types\r\n48: \r\n49: \r\n50:     // ─────── AI hooks ───────\r\n51:     #ifdef BITLOOP_DEV_MODE\r\n52:     std::uint64_t diagnostic_ticks = 0;\r\n53:     double diagnostic_time_seconds = 0.0;\r\n54: \r\n55:     void traceFrame(SimTraceFrame& frame) const override;\r\n56:     bool saveCheckpoint(SimCheckpointWriter& writer) const override;\r\n57:     bool loadCheckpoint(const SimCheckpointReader& reader) override;\r\n58:     #endif\r\n59: };\r\n60: \r\n61: struct Substrate_Project : public Project<Substrate_Project>\r\n62: {\r\n63:     static ProjectInfo info()\r\n64:     {\r\n65:         return ProjectInfo({ \"New Projects\", \"Substrate\" });\r\n66:     }\r\n67: \r\n68:     struct UI : BufferedInterfaceModel\r\n69:     {\r\n70:         using BufferedInterfaceModel::BufferedInterfaceModel;\r\n71:         void sidebar();\r\n72:         // void overlay();\r\n73:     };\r\n74: \r\n75:     int viewport_count = 1;\r\n76: \r\n77:     void projectPrepare(Layout& layout) override;\r\n78: };\r\n79: \r\n80: SIM_END;\r\n",
