                        "output": {
                            "identity": "fnv1a64:d467426868a4124e",
                            "lines": "1: cmake_minimum_required(VERSION 3.21)\r\n2: project(Substrate NONE)\r\n3: \r\n4: include(\"${CMAKE_CURRENT_LIST_DIR}/tooling/findBitloop.cmake\")\r\n5: \r\n6: bitloop_enable_languages(LANGUAGES C CXX)\r\n7: \r\n8: \r\n9: set(SRC_DIR \"${CMAKE_CURRENT_LIST_DIR}/Substrate\")\r\n10: file(GLOB_RECURSE SIM_SOURCES CONFIGURE_DEPENDS\r\n11:     \"${SRC_DIR}/*.cpp\"\r\n12:     \"${SRC_DIR}/*.h\"\r\n13:     \"${SRC_DIR}/*.hpp\"\r\n14: )\r\n15: \r\n16: bitloop_new_project(Substrate ${SIM_SOURCES})\r\n17: \r\n18: bitloop_finalize()\r\n19: \r\n",
