            "receipt": {
                "auth": "chatgpt",
                "model": "gpt-6-astra",
                "provider": "codex",
                "thread_id": "01a11672-487f-7051-8bcf-82492dc32b94",
                "turn_id": "01a11672-48e2-71a1-8fad-4c6a3f9379c7"
            },
            "response": "{\n  \"architecture\": {\n    \"components\": [\n      {\n        \"id\": \"C-state\",\n        \"name\": \"Authoritative world and advancement\",\n        \"responsibility\": \"Own stable structural identities, material inventories, committed time, staged advancement, explicit exchanges, validity checks and bounded failure handling. Remain independent of Bitloop lifecycle and diagnostics.\"\n      },\n      {\n        \"id\": \"C-mechanics\",\n        \"name\": \"Structures and chamber contents\",\n        \"responsibility\": \"Represent deformable tissue, membranes, contractile edges and stiff supports; compute contact, chamber geometry, contained-material inertia, pressure and paired mechanical work.\"\n      },\n      {\n        \"id\": \"C-field\",\n        \"name\": \"Fluid and boundary geometry\",\n        \"responsibility\": \"Own spatial fluid state and compatible moving-boundary geometry, pressure, face fluxes and transport operators without mixing opposite sides of intact membranes.\"\n      },\n      {\n        \"id\": \"C-processes\",\n        \"name\": \"Resource exchange and activity\",\n        \"responsibility\": \"Own conservative species transport, finite membrane/channel transfers, declared reactions and fuel-limited local actuation.\"\n      },\n      {\n        \"id\": \"C-experiments\",\n        \"name\": \"Construction and local control\",\n        \"responsibility\": \"Construct seeded fixtures from common physical interfaces, provide constrained local sensing and deterministic control, and declare workloads without embedding organism-specific physics in the core.\"\n      },\n      {\n        \"id\": \"C-adapter\",\n        \"name\": \"Bitloop shell and evidence adapters\",\n        \"responsibility\": \"Keep Substrate.h/.cpp thin; adapt configuration, advancement, rendering and development telemetry to existing Bitloop facilities. Own observational output outside the physics core.\"\n      }\n    ],\n    \"decisions\": [\n      {\n        \"decision\": \"Authorize planning for a supervised setup loop and an explicitly approved, bounded coupled foundation proof, followed conditionally by an interactive-laboratory qualification. Do not implement the 256-organism rich world or longer-term biology in this package.\",\n        \"id\": \"D-scope\",\n        \"rationale\": \"The vision explicitly requires early feasibility before broader features and does not authorize the whole ambition. The rich-world figures remain future targets, not acceptance claims for this package.\"\n      },\n      {\n        \"decision\": \"Use one CPU production world with explicit compliant structures, geometry-coupled well-mixed chambers, and a conservative spatial fluid field. Investigate a staggered finite-volume pressure projection with side-separated cut geometry as the provisional fluid candidate.\",\n        \"id\": \"D-candidate\",\n        \"rationale\": \"This follows the preferred representation while exposing thin barriers, small cut cells and global pressure costs. It is a hypothesis pending design approval and coupled evidence, not an adopted solver.\"\n      },\n      {\n        \"decision\": \"Use area-based two-dimensional units, explicit amount/impulse/work exchanges and a single authoritative owner for each conserved quantity. Public identity belongs to meaningful structures and inventories, not numerical samples.\",\n        \"id\": \"D-ownership\",\n        \"rationale\": \"Compatible local accounting and geometry are prerequisites for reliable biological interpretation.\"\n      },\n      {\n        \"decision\": \"Advance requested physical intervals transactionally using bounded staging and bounded retries; never skip failed time. Keep physical dissipation and numerical energy residual distinct, and never recycle residual into fuel or heat.\",\n        \"id\": \"D-validity\",\n        \"rationale\": \"Failure must preserve the last valid state and actual time without allowing numerical error to become a biological advantage.\"\n      },\n      {\n        \"decision\": \"Freeze physical tolerances, resolution limits, experiment horizons and complete-cost budgets before the acceptance campaign. Adoption requires physical behavior and cost together; changes require an explicit human tradeoff.\",\n        \"id\": \"D-gates\",\n        \"rationale\": \"Global balances, attractive images and short benchmarks cannot substitute for local physical correctness and sustained affordable activity.\"\n      },\n      {\n        \"decision\": \"Reuse project-owned adapters for Bitloop lifecycle, headless traces and snapshots. Do not introduce a logging SDK, backend menu, genome framework, automatic representation switching or checkpoint implementation in this early package.\",\n        \"id\": \"D-boundary\",\n        \"rationale\": \"The smallest useful foundation needs reproducible seeded runs, not speculative infrastructure. Framework changes require separate explicit authorization.\"\n      }\n    ],\n    \"relationships\": [\n      {\n        \"from\": \"C-state\",\n        \"relationship\": \"Schedules staged mechanics and receives validity, impulse and work results\",\n        \"to\": \"C-mechanics\"\n      },\n      {\n        \"from\": \"C-state\",\n        \"relationship\": \"Schedules pressure and flux updates against the same committed interval\",\n        \"to\": \"C-field\"\n      },\n      {\n        \"from\": \"C-mechanics\",\n        \"relationship\": \"Supplies oriented moving boundaries and receives equal-and-opposite fluid traction through the shared geometry contract\",\n        \"to\": \"C-field\"\n      },\n      {\n        \"from\": \"C-processes\",\n        \"relationship\": \"Transfers owned amounts and energy through the world's paired exchange interface\",\n        \"to\": \"C-state\"\n      },\n      {\n        \"from\": \"C-processes\",\n        \"relationship\": \"Uses accepted material face fluxes for conservative species movement\",\n        \"to\": \"C-field\"\n      },\n      {\n        \"from\": \"C-processes\",\n        \"relationship\": \"Provides resource-bounded actuation and chamber exchange requests\",\n        \"to\": \"C-mechanics\"\n      },\n      {\n        \"from\": \"C-experiments\",\n        \"relationship\": \"Constructs initial state and submits local sensing, actuation and transfer requests\",\n        \"to\": \"C-state\"\n      },\n      {\n        \"from\": \"C-adapter\",\n        \"relationship\": \"Owns the engine instance and observes committed state without owning physical inventories\",\n        \"to\": \"C-state\"\n      },\n      {\n        \"from\": \"C-adapter\",\n        \"relationship\": \"Selects fixtures and presents their controls and observations\",\n        \"to\": \"C-experiments\"\n      }\n    ],\n    \"summary\": \"A project-owned CPU simulation core combines explicit deformable structures, honest pressure-bearing compartments and conservative grid fluid/transport through one geometry and exchange contract. The plan first establishes a trustworthy supervised workflow, then separately resolves numerical obligations and obtains human approval before implementing independently testable kernels. A minimal coupled organism decides feasibility before resource-rich demonstrations and a 16-organism laboratory qualification. Larger worlds, damage/repair, thermal state, evolution and checkpoint infrastructure remain outside this bounded package.\"\n  },\n  \"artifacts\": [\n    {\n      \"description\": \"Runnable minimal project-owned fixture and retained setup-loop findings identifying actual build, supported Bitloop hooks, saved result and review/reload behavior; no physics validation claim.\",\n      \"id\": \"A-bootstrap\",\n      \"produced_by\": \"T-bootstrap\",\n      \"title\": \"Supervised workflow baseline\"\n    },\n    {\n      \"description\": \"Predeclared physical references, scales, local and cumulative budgets, cost accounting, workload geometry, horizon rules, rejection conditions and unresolved choices requiring approval.\",\n      \"id\": \"A-protocol\",\n      \"produced_by\": \"T-protocol\",\n      \"title\": \"Candidate experiment protocol\"\n    },\n    {\n      \"description\": \"Authoritative state and exchange data shapes, units, identities, ownership transitions and error categories shared by all kernels.\",\n      \"id\": \"A-state-design\",\n      \"produced_by\": \"T-state-design\",\n      \"title\": \"State and exchange specification\"\n    },\n    {\n      \"description\": \"Discrete compliant mechanics and contained-material model, including mass/inertia, geometry-linked pressure, stored energy, contact and worked pressure-volume examples.\",\n      \"id\": \"A-mechanics-design\",\n      \"produced_by\": \"T-mechanics-design\",\n      \"title\": \"Structure and chamber specification\"\n    },\n    {\n      \"description\": \"Oriented geometry, side-separated control volumes, face fluxes, swept areas, pressure/traction operators, small-cell treatment and worked support-change references.\",\n      \"id\": \"A-field-design\",\n      \"produced_by\": \"T-field-design\",\n      \"title\": \"Compatible geometry and flow specification\"\n    },\n    {\n      \"description\": \"Reconciled version of state, mechanics and field interfaces plus coupling order, convergence tests, retry limits, staging plan, cost allocation and proposed approval package.\",\n      \"id\": \"A-coupled-design\",\n      \"produced_by\": \"T-coupled-design\",\n      \"title\": \"Reconciled coupled work package\"\n    },\n    {\n      \"description\": \"Implemented authoritative world and bounded advancement/exchange interfaces with focused validity and failure tests.\",\n      \"id\": \"A-world\",\n      \"produced_by\": \"T-world\",\n      \"title\": \"Transactional world foundation\"\n    },\n    {\n      \"description\": \"Tested passive deformable structures, membrane contact and stiff-support behavior at the approved resolution and quality.\",\n      \"id\": \"A-mechanics\",\n      \"produced_by\": \"T-mechanics\",\n      \"title\": \"Passive mechanics implementation\"\n    },\n    {\n      \"description\": \"Tested chamber inventories, mass/inertia and geometry-linked pressure/work response, explicitly limited to well-mixed supported contents.\",\n      \"id\": \"A-chambers\",\n      \"produced_by\": \"T-chambers\",\n      \"title\": \"Contained-material implementation\"\n    },\n    {\n      \"description\": \"Tested stationary fluid reference operators and pressure-solve telemetry, with numerical and complete-step cost observations.\",\n      \"id\": \"A-field\",\n      \"produced_by\": \"T-field\",\n      \"title\": \"Stationary field implementation\"\n    },\n    {\n      \"description\": \"Tested side-separated geometry and moving-boundary operators exposing all exchanges required by mechanics and transport.\",\n      \"id\": \"A-geometry\",\n      \"produced_by\": \"T-geometry\",\n      \"title\": \"Boundary geometry implementation\"\n    },\n    {\n      \"description\": \"Prescribed-boundary experiment results, counterexamples and implemented fluid response, including local volume, barrier, work and cost findings.\",\n      \"id\": \"A-moving-boundary\",\n      \"produced_by\": \"T-moving-boundary\",\n      \"title\": \"Moving-boundary qualification\"\n    },\n    {\n      \"description\": \"Smallest passive coupled chamber/tissue/fluid fixture and decision-bearing physical and end-to-end cost findings, including negative or inconclusive outcomes.\",\n      \"id\": \"A-passive-proof\",\n      \"produced_by\": \"T-passive-proof\",\n      \"title\": \"Passive coupled feasibility evidence\"\n    },\n    {\n      \"description\": \"Conservative field species transport and tissue/chamber inventory operations tested independently of reactions and actuation.\",\n      \"id\": \"A-transport\",\n      \"produced_by\": \"T-transport\",\n      \"title\": \"Resource transport implementation\"\n    },\n    {\n      \"description\": \"Finite channel and membrane transfers and explicit reaction accounting with positivity, balance and limiting tests.\",\n      \"id\": \"A-exchange\",\n      \"produced_by\": \"T-exchange\",\n      \"title\": \"Transfer and reaction implementation\"\n    },\n    {\n      \"description\": \"Bounded sensor/request interface, deterministic minimal controller and fuel-constrained actuation with work and starvation tests.\",\n      \"id\": \"A-activity\",\n      \"produced_by\": \"T-activity\",\n      \"title\": \"Resource-limited activity implementation\"\n    },\n    {\n      \"description\": \"Runnable first active coupled proof and retained comparisons for motion, transport, resource cost, local errors, refinement and complete cost.\",\n      \"id\": \"A-active-proof\",\n      \"produced_by\": \"T-active-proof\",\n      \"title\": \"Active organism feasibility evidence\"\n    },\n    {\n      \"description\": \"Common-vocabulary crawler, swimmer and chambered pump configurations plus shared active laboratory setup and inspected visual/semantic examples.\",\n      \"id\": \"A-lab\",\n      \"produced_by\": \"T-lab\",\n      \"title\": \"Composable organism laboratory\"\n    },\n    {\n      \"description\": \"Reproducible 16-organism qualification report, run instructions, published supported range and known limits; clearly distinguishes achieved results from future rich-world targets.\",\n      \"id\": \"A-qualification\",\n      \"produced_by\": \"T-qualification\",\n      \"title\": \"Laboratory acceptance package\"\n    }\n  ],\n  \"assumptions\": [\n    {\n      \"id\": \"S-scope\",\n      \"statement\": \"This initial plan ends at the interactive laboratory. The first rich world, damage/repair, thermal transport, reproduction and 1,024-organism ambition require subsequent approved work packages.\"\n    },\n    {\n      \"id\": \"S-hardware\",\n      \"statement\": \"Access to the proposed Ryzen 9 9950X3D reference machine is not established. Other hardware can supply development evidence, but cannot substantiate that machine's throughput target.\"\n    },\n    {\n      \"id\": \"S-domain\",\n      \"statement\": \"The early habitat may use a fully filled liquid domain with explicit terrain and no resolved free surface. Supported walls, passages and tissue features will be bounded by an approved minimum resolution.\"\n    },\n    {\n      \"id\": \"S-model\",\n      \"statement\": \"Well-mixed chambers will be used only where internal circulation and concentration gradients do not determine the tested behavior; chamber inertia must still be modeled and validated.\"\n    },\n    {\n      \"id\": \"S-replay\",\n      \"statement\": \"Seeded initial conditions and deterministic replay on one declared execution configuration are sufficient for this package. Save/restore continuation is not claimed or required yet.\"\n    }\n  ],\n  \"questions\": [],\n  \"status\": \"ready\",\n  \"tasks\": [\n    {\n      \"acceptance_criteria\": [\n        \"A human-supervised minimal target compiles and runs in a Codex-owned build context without changing framework or sibling sources.\",\n        \"Capability bitloop and traces are exercised with actual scene/build identity, command, fixed timestep and a small implemented semantic counter; retained output is inspected rather than inferred from exit status.\",\n        \"A supported mindgraph-result records observations and limitations; the human confirms saved result, review and reload preserve them, or records a minimal management failure reproducer.\",\n        \"Unavailable hooks or required ownership changes are reported without implementing management workarounds in the physics core.\"\n      ],\n      \"components\": [\"C-adapter\"],\n      \"context\": \"Use capability bitloop at .mindgraph/project_capabilities/bitloop.md and routed .agents/skills/bitloop-development/SKILL.md; use traces at .mindgraph/project_capabilities/traces.md and references/tracing-diagnostics.md beneath that skill. Inspect actual APIs and build state. This is the vision's supervised bounded first task, not a numerical prototype. Record source/build identity and compact evidence under .codex/runs; use only supported result fields.\",\n      \"depends_on\": [],\n      \"goal\": \"Establish that a fresh worker can safely build, observe and preserve evidence through the existing project workflow.\",\n      \"id\": \"T-bootstrap\",\n      \"input_artifacts\": [],\n      \"parent_id\": null,\n      \"plan_review\": {\n        \"question\": \"Does the supervised execution/result/review/reload loop preserve decision-bearing evidence well enough to proceed, or must management issues be fixed by their owning project first?\"\n      },\n      \"title\": \"Exercise the supervised Bitloop and MindGraph loop\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"The separate design obligations have explicit interfaces, worked references and predeclared acceptance budgets.\",\n        \"A reconciled work package reaches an explicit human decision before numerical implementation.\"\n      ],\n      \"components\": [\"C-state\", \"C-mechanics\", \"C-field\", \"C-processes\"],\n      \"context\": \"Organizational outcome for D-candidate and D-gates; children establish specifications, not adoption evidence.\",\n      \"depends_on\": [],\n      \"goal\": \"Make the candidate's numerical meaning, cost and rejection conditions reviewable before implementation.\",\n      \"id\": \"T-foundation-design\",\n      \"input_artifacts\": [],\n      \"parent_id\": null,\n      \"plan_review\": null,\n      \"title\": \"Specify and approve the bounded foundation\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"Declare units, meaningful motion/resource scales, physical oracles, local and cumulative numerical budgets and refinement comparisons before collecting acceptance results.\",\n        \"Define uniform pressure, translation/rotation, free expansion, compression/recovery, sealed motion, advection/diffusion, weak-motion preservation and cyclic energy tests.\",\n        \"Specify bounded experiment runtime and memory budgets, timescale-derived horizons, stopping rules and rejection criteria; identify any proposed values as requiring human approval.\",\n        \"Freeze a first-proof fixture and a 16-organism laboratory workload using the vision's complexity and 128 by 128 active field, with one simulated second per wall-clock second as the proposed laboratory throughput gate.\",\n        \"Separate complete calculated-frame timing from rendering/output, include retries and staging, and retain the rich-world targets only as future comparison context.\"\n      ],\n      \"components\": [\"C-state\", \"C-experiments\"],\n      \"context\": \"Consume A-bootstrap for available execution/evidence mechanisms. D-gates governs budgets; no thresholds may be relaxed after failure without an explicit human tradeoff. Use simulation-health: .mindgraph/project_capabilities/simulation-health.md and .agents/skills/bitloop-development/references/simulation-health-diagnostics.md for horizon and inspection planning. Do not adopt the rich-world ten-minute requirement as an invented laboratory requirement; propose and justify the laboratory horizon.\",\n      \"depends_on\": [\"T-bootstrap\"],\n      \"goal\": \"Predeclare the bounded experiment and qualification criteria, including what evidence would reject the candidate.\",\n      \"id\": \"T-protocol\",\n      \"input_artifacts\": [\"A-bootstrap\"],\n      \"parent_id\": \"T-foundation-design\",\n      \"plan_review\": null,\n      \"title\": \"Define experimental requirements and budgets\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"Specify compact state shapes for structural identities, geometry, mass, momentum, species amounts, chamber inventories, field state and energy accounts.\",\n        \"Define an exchange record with source/destination ownership, amount, impulse, work, elapsed interval and rejection semantics; no inventory has simultaneous authoritative copies.\",\n        \"Define read-only observations and local requests without exposing mutable world state to controllers or adapters.\",\n        \"Give worked paired-transfer and failed-update examples and explicit unsupported-condition errors.\"\n      ],\n      \"components\": [\"C-state\"],\n      \"context\": \"Use D-ownership and D-validity plus A-protocol. Define interfaces, not a general ECS, registry or serialization system. Dense storage indices remain private. Coupled advancement ordering is reserved for T-coupled-design.\",\n      \"depends_on\": [\"T-protocol\"],\n      \"goal\": \"Establish the authoritative data and exchange boundary consumed by numerical designs.\",\n      \"id\": \"T-state-design\",\n      \"input_artifacts\": [\"A-protocol\"],\n      \"parent_id\": \"T-foundation-design\",\n      \"plan_review\": null,\n      \"title\": \"Specify authoritative state and exchanges\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"Choose and derive a bounded compliant element integration/contact scheme with deformation, thickness and work limits; define stiff-support representation without a backend menu.\",\n        \"Specify chamber pressure as a function of actual enclosed area and owned material state, together with mass/inertia distribution and wall work.\",\n        \"Provide worked translation, rotation, compression and expansion references separating structural mass from contained mass.\",\n        \"State precisely where the well-mixed inertia approximation is valid and which observations would disqualify it.\"\n      ],\n      \"components\": [\"C-mechanics\"],\n      \"context\": \"Consume A-state-design and A-protocol under provisional D-candidate and S-model. Cover passive material meaning and geometry-linked chamber response only; contraction, reactions and channels are later packages. Derivations must be implementable by separate fresh workers.\",\n      \"depends_on\": [\"T-state-design\", \"T-protocol\"],\n      \"goal\": \"Resolve passive mechanics and contained-material numerical meaning independently of the fluid implementation.\",\n      \"id\": \"T-mechanics-design\",\n      \"input_artifacts\": [\"A-state-design\", \"A-protocol\"],\n      \"parent_id\": \"T-foundation-design\",\n      \"plan_review\": null,\n      \"title\": \"Design passive structures and honest chamber contents\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"Define oriented membrane segments, side labels, occupied/open areas, apertures, swept-area fluxes and geometry versioning with units and ownership.\",\n        \"Specify pressure, divergence, transport and boundary traction operators that use compatible geometry, including paired work.\",\n        \"Choose a concrete small-cut-cell treatment, pressure solver and bounded convergence policy without silently deleting barriers or merging opposite sides.\",\n        \"Provide hand-worked moving-corner, narrow-passage, support-change, uniform-pressure and free-expansion cases with local as well as global expected quantities.\",\n        \"State minimum supported feature sizes and explicit errors for unsupported topology or geometry.\"\n      ],\n      \"components\": [\"C-field\"],\n      \"context\": \"Consume A-state-design and A-protocol. D-candidate is provisional: design the staggered conservative candidate, reporting contradictions rather than silently changing the representation. No automatic refinement, free surfaces or generalized geometry engine.\",\n      \"depends_on\": [\"T-state-design\", \"T-protocol\"],\n      \"goal\": \"Resolve the shared geometric meaning of volume, pressure and transported amounts before implementing flow.\",\n      \"id\": \"T-field-design\",\n      \"input_artifacts\": [\"A-state-design\", \"A-protocol\"],\n      \"parent_id\": \"T-foundation-design\",\n      \"plan_review\": null,\n      \"title\": \"Design compatible geometry and field operators\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"Reconcile all cross-component units, signs, geometry timing and exchange fields into one canonical contract with a worked coupled substep.\",\n        \"Specify substep order, traction/velocity coupling, convergence criteria, maximum iterations/retries and response to exhausted budgets.\",\n        \"Describe staging and commit boundaries that preserve committed state and time without requiring full-world copies at every mechanical microstep.\",\n        \"Allocate measurable complete-step costs including geometry, pressure solve, contact, safety scans and recovery tails.\",\n        \"List unresolved contradictions explicitly; do not present a complete document as proof of feasibility.\"\n      ],\n      \"components\": [\"C-state\", \"C-mechanics\", \"C-field\"],\n      \"context\": \"Consume all design outputs and A-protocol. This task reconciles already defined mechanisms rather than designing the entire engine from scratch. Produce the exact bounded work package proposed for human approval under D-validity and D-gates.\",\n      \"depends_on\": [\"T-protocol\", \"T-state-design\", \"T-mechanics-design\", \"T-field-design\"],\n      \"goal\": \"Establish one implementable coupling and failure schedule across the independent numerical designs.\",\n      \"id\": \"T-coupled-design\",\n      \"input_artifacts\": [\"A-protocol\", \"A-state-design\", \"A-mechanics-design\", \"A-field-design\"],\n      \"parent_id\": \"T-foundation-design\",\n      \"plan_review\": {\n        \"question\": \"Do the reconciled geometry, chamber inertia, pressure work and bounded advancement choices plausibly satisfy D-candidate and D-validity within A-protocol, or is a design change needed before seeking implementation approval?\"\n      },\n      \"title\": \"Reconcile coupled advancement and failure semantics\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"The human explicitly approves the numerical work package, tolerances, workload, experiment spending limits and scope, or requests changes.\",\n        \"Silence, plan application, report existence and automated review are not treated as approval.\",\n        \"If approval is withheld, dependent implementation remains blocked.\"\n      ],\n      \"components\": [\"C-state\", \"C-mechanics\", \"C-field\"],\n      \"context\": \"Present A-coupled-design and A-protocol after their review. This is a human decision task, not another numerical design or a request for framework changes. Record the actual decision in supported task result fields.\",\n      \"depends_on\": [\"T-coupled-design\", \"T-protocol\"],\n      \"goal\": \"Obtain the vision's explicit approval for the first physical proof and its numerical choices.\",\n      \"id\": \"T-approval\",\n      \"input_artifacts\": [\"A-coupled-design\", \"A-protocol\"],\n      \"parent_id\": \"T-foundation-design\",\n      \"plan_review\": null,\n      \"title\": \"Obtain human approval for the experiment\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"Independent mechanical, chamber, field and geometry checks meet the approved conditions or retain decisive counterexamples.\",\n        \"A smallest passive coupled fixture establishes local physical behavior and complete cost before activity features are released.\"\n      ],\n      \"components\": [\"C-state\", \"C-mechanics\", \"C-field\"],\n      \"context\": \"Organizational outcome; implementation is conditional on T-approval and each applicable review. Numerical failure is useful evidence, not adoption.\",\n      \"depends_on\": [],\n      \"goal\": \"Test the expensive and uncertain physical foundation before broader biology.\",\n      \"id\": \"T-passive-foundation\",\n      \"input_artifacts\": [],\n      \"parent_id\": null,\n      \"plan_review\": null,\n      \"title\": \"Establish coupled physical feasibility\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"Core builds without scene, rendering, UI, trace formatting or file-output dependencies.\",\n        \"Focused tests verify unique ownership, paired exchanges, deterministic interval advancement and finite committed state.\",\n        \"Injected kernel failures and exhausted retries leave the last committed state and time unchanged and return an actionable error.\",\n        \"Staging allocation and memory costs are measurable; no unconditional full-world copy is hidden in each mechanical substep.\"\n      ],\n      \"components\": [\"C-state\"],\n      \"context\": \"Implement A-coupled-design after explicit approval. Use capability bitloop (.mindgraph/project_capabilities/bitloop.md; .agents/skills/bitloop-development/SKILL.md) only for project build integration and public foundational facilities. Do not add general serialization or framework changes.\",\n      \"depends_on\": [\"T-approval\", \"T-coupled-design\"],\n      \"goal\": \"Provide the tested state and advancement skeleton for independent kernels.\",\n      \"id\": \"T-world\",\n      \"input_artifacts\": [\"A-coupled-design\"],\n      \"parent_id\": \"T-passive-foundation\",\n      \"plan_review\": null,\n      \"title\": \"Implement authoritative state and bounded advancement\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"Translation/rotation, compression/recovery, shear and passive cyclic cases meet approved local deformation and energy-error budgets.\",\n        \"Supported membrane and terrain contacts prevent forbidden passage, including corner and narrow-feature cases.\",\n        \"Reactions and external support work are exposed through A-world; degeneracy returns an explicit failure rather than deleting or freezing material.\"\n      ],\n      \"components\": [\"C-mechanics\"],\n      \"context\": \"Implement only passive structures and stiff supports from canonical A-coupled-design using A-world and A-protocol. Chamber contents and fluid coupling remain separate. Use simulation-health (.mindgraph/project_capabilities/simulation-health.md; references/simulation-health-diagnostics.md under the Bitloop skill) for cyclic horizons and durable invariant coverage.\",\n      \"depends_on\": [\"T-world\", \"T-coupled-design\", \"T-protocol\"],\n      \"goal\": \"Build independently testable passive mechanics and contact.\",\n      \"id\": \"T-mechanics\",\n      \"input_artifacts\": [\"A-world\", \"A-coupled-design\", \"A-protocol\"],\n      \"parent_id\": \"T-passive-foundation\",\n      \"plan_review\": null,\n      \"title\": \"Implement passive structures and contact\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"Prescribed chamber translation, rotation, compression and free expansion reproduce the approved inertia and pressure/work references.\",\n        \"Pressure uses measured chamber geometry; amount, density and stored energy do not evolve against a private unrelated volume.\",\n        \"Degenerate or unsupported chambers reject advancement without inventory loss.\",\n        \"The supported well-mixed approximation and excluded internal-flow behaviors are documented.\"\n      ],\n      \"components\": [\"C-mechanics\"],\n      \"context\": \"Use A-world, A-coupled-design and A-protocol. A prescribed geometry harness permits testing independently of the deformable solver. Do not add permeability, instantaneous interchamber mixing or arbitrary release velocities.\",\n      \"depends_on\": [\"T-world\", \"T-coupled-design\", \"T-protocol\"],\n      \"goal\": \"Implement contained-material response without relying on fluid or organism behavior to hide errors.\",\n      \"id\": \"T-chambers\",\n      \"input_artifacts\": [\"A-world\", \"A-coupled-design\", \"A-protocol\"],\n      \"parent_id\": \"T-passive-foundation\",\n      \"plan_review\": null,\n      \"title\": \"Implement geometry-coupled chamber response\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"Stationary uniform-pressure, manufactured/reference flow and flux-divergence cases meet the approved tolerances.\",\n        \"Pressure residual, iteration count, material balance and numerical work are observable.\",\n        \"Complete stationary-field timings include staging, solver setup and checks rather than only a force or pressure kernel.\",\n        \"Unconverged solves return bounded failure and preserve committed state.\"\n      ],\n      \"components\": [\"C-field\"],\n      \"context\": \"Implement stationary regular-grid reference flow from A-coupled-design and A-world, judged by A-protocol. Moving cuts and species are excluded. Use traces (.mindgraph/project_capabilities/traces.md; .agents/skills/bitloop-development/references/tracing-diagnostics.md) via a project-owned adapter, verifying semantic hooks rather than assuming generated telemetry.\",\n      \"depends_on\": [\"T-world\", \"T-coupled-design\", \"T-protocol\"],\n      \"goal\": \"Provide a validated stationary baseline for isolating moving-boundary errors and costs.\",\n      \"id\": \"T-field\",\n      \"input_artifacts\": [\"A-world\", \"A-coupled-design\", \"A-protocol\"],\n      \"parent_id\": \"T-passive-foundation\",\n      \"plan_review\": null,\n      \"title\": \"Implement the stationary conservative field\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"Worked geometry cases reproduce occupied/open areas, side identities, apertures and swept-area exchanges.\",\n        \"Thin membranes prevent interpolation across sides, and supported moving corners/passages remain explicit.\",\n        \"Support changes preserve local geometry/volume continuity within the approved tolerance.\",\n        \"Small-cell and unsupported-feature handling follows the approved contract and exposes its work cost.\"\n      ],\n      \"components\": [\"C-field\", \"C-mechanics\"],\n      \"context\": \"Use A-world, A-coupled-design and A-protocol. Implement shared geometric operators, not a second authoritative material inventory or a general meshing framework. Focused analytic geometry tests suffice here; dynamic pressure response belongs to T-moving-boundary.\",\n      \"depends_on\": [\"T-world\", \"T-coupled-design\", \"T-protocol\"],\n      \"goal\": \"Create independently tested geometry exchanges shared by collision, pressure and transport.\",\n      \"id\": \"T-geometry\",\n      \"input_artifacts\": [\"A-world\", \"A-coupled-design\", \"A-protocol\"],\n      \"parent_id\": \"T-passive-foundation\",\n      \"plan_review\": null,\n      \"title\": \"Implement side-separated moving geometry\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"Prescribed translation, rotation, compression and free expansion test local pressure/volume fields, barrier leakage, displaced fluid and wall work.\",\n        \"Moving corners, near-minimum passages and support changes are exercised at multiple approved resolutions and timesteps.\",\n        \"Measure timestep restrictions, convergence, geometry/pressure cost, memory and retries over the bounded protocol.\",\n        \"Retain failed cases and distinguish completed experimentation from a suitable moving-boundary method.\"\n      ],\n      \"components\": [\"C-field\", \"C-adapter\"],\n      \"context\": \"Join A-field and A-geometry under A-coupled-design without deformable feedback yet. Use A-protocol. Capabilities traces and simulation-health: .mindgraph/project_capabilities/traces.md, .mindgraph/project_capabilities/simulation-health.md and the corresponding tracing-diagnostics.md and simulation-health-diagnostics.md skill references. Retain numerical summaries and commands under .codex/runs.\",\n      \"depends_on\": [\"T-field\", \"T-geometry\", \"T-coupled-design\", \"T-protocol\"],\n      \"goal\": \"Expose the moving-interface candidate's core physical and cost risks before two-way integration.\",\n      \"id\": \"T-moving-boundary\",\n      \"input_artifacts\": [\"A-field\", \"A-geometry\", \"A-coupled-design\", \"A-protocol\"],\n      \"parent_id\": \"T-passive-foundation\",\n      \"plan_review\": {\n        \"question\": \"Do local displacement, barrier continuity and measured small-cell/pressure costs support D-candidate within the approved budget, or should the representation be reconsidered before two-way coupling?\"\n      },\n      \"title\": \"Qualify prescribed moving-boundary response\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"A deformable pressure chamber exchanges two-way reactions and work with surrounding liquid using one advancement schedule.\",\n        \"Rest, weak perturbation, compression/recovery and externally driven cycles satisfy local geometry, containment, momentum and numerical-energy budgets.\",\n        \"Resolution comparisons detect collapsed features, passive propulsion and loss of weak motion; health monitoring covers the protocol's timescales.\",\n        \"Complete interval cost includes contact, coupling iterations, rejected attempts, checks and commit; report active counts and memory.\",\n        \"Provide a reproducible headless command and inspected snapshots correlated with semantic state, including negative or inconclusive findings.\"\n      ],\n      \"components\": [\"C-state\", \"C-mechanics\", \"C-field\", \"C-adapter\"],\n      \"context\": \"Conditional on moving-boundary review accepting continued investigation. Integrate A-mechanics, A-chambers and A-moving-boundary under A-coupled-design and A-protocol; no resources/controllers yet. Use traces and simulation-health hint files and their routed diagnostic references. Use snapshots-checkpoints (.mindgraph/project_capabilities/snapshots-checkpoints.md; .agents/skills/bitloop-development/references/checkpoints-snapshots.md and visual-qa.md) for images only, not serialization.\",\n      \"depends_on\": [\"T-mechanics\", \"T-chambers\", \"T-moving-boundary\", \"T-coupled-design\", \"T-protocol\"],\n      \"goal\": \"Reach the smallest coupled feasibility test before adding biological processes.\",\n      \"id\": \"T-passive-proof\",\n      \"input_artifacts\": [\"A-mechanics\", \"A-chambers\", \"A-moving-boundary\", \"A-coupled-design\", \"A-protocol\"],\n      \"parent_id\": \"T-passive-foundation\",\n      \"plan_review\": {\n        \"question\": \"Does the complete passive trajectory validate the chamber inertia and two-way coupling assumptions at affordable cost, or does D-candidate need revision before adding activity?\"\n      },\n      \"title\": \"Demonstrate passive two-way coupled feasibility\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"The first proof combines deformable tissue, pressure, moving fluid, nutrient exchange and fuel-limited actuation.\",\n        \"The conditional laboratory demonstrates distinct constructions and measures active shared-world performance without claiming rich-world acceptance.\"\n      ],\n      \"components\": [\"C-processes\", \"C-experiments\", \"C-adapter\"],\n      \"context\": \"Organizational outcome under D-scope. Children preserve independent transport, transfer/reaction and actuation checks before integration.\",\n      \"depends_on\": [],\n      \"goal\": \"Turn an accepted physical foundation into a small useful active organism laboratory.\",\n      \"id\": \"T-active-lab\",\n      \"input_artifacts\": [],\n      \"parent_id\": null,\n      \"plan_review\": null,\n      \"title\": \"Establish resource-limited organisms and laboratory\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"Field advection/diffusion and compartment/tissue storage preserve owned amounts and nonnegativity within approved tolerances.\",\n        \"Sealed moving barriers block species flux; uniform concentration and localized gradient references check local fields independently of global totals.\",\n        \"Refinement quantifies numerical diffusion relative to the sensing/feeding scales in A-protocol.\",\n        \"Transport uses accepted fluid fluxes and elapsed time, including any approved lower-rate updates.\"\n      ],\n      \"components\": [\"C-processes\", \"C-field\"],\n      \"context\": \"Conditional on A-passive-proof review. Implement the small declared species set from A-protocol using A-coupled-design exchanges; no reaction, pump or actuator logic. Use simulation-health at .mindgraph/project_capabilities/simulation-health.md and its simulation-health-diagnostics.md reference for accumulation horizons.\",\n      \"depends_on\": [\"T-passive-proof\", \"T-coupled-design\", \"T-protocol\"],\n      \"goal\": \"Establish conservative resource movement before adding conversion or activity.\",\n      \"id\": \"T-transport\",\n      \"input_artifacts\": [\"A-passive-proof\", \"A-coupled-design\", \"A-protocol\"],\n      \"parent_id\": \"T-active-lab\",\n      \"plan_review\": null,\n      \"title\": \"Implement conserved resource transport\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"Channels and membrane permeability produce finite rate-limited paired transfers driven by declared local states.\",\n        \"Closed, open and permeable cases measure expected flux without instantaneous connected-chamber mixing.\",\n        \"Nutrient/fuel/waste reactions declare stoichiometry, rates and energy meaning; exhausted donors cannot become negative or produce free fuel.\",\n        \"Competing simultaneous requests and failed updates neither duplicate inventories nor partially commit reactions.\"\n      ],\n      \"components\": [\"C-processes\"],\n      \"context\": \"Consume A-transport, A-coupled-design and A-protocol. Keep resource flux separate from controller policy and actuator work. Reuse the existing ownership/exchange interface; rupture, damage and repair are excluded from this package.\",\n      \"depends_on\": [\"T-transport\", \"T-coupled-design\", \"T-protocol\"],\n      \"goal\": \"Enable meaningful feeding, permeability and metabolic conversion with explicit local costs.\",\n      \"id\": \"T-exchange\",\n      \"input_artifacts\": [\"A-transport\", \"A-coupled-design\", \"A-protocol\"],\n      \"parent_id\": \"T-active-lab\",\n      \"plan_review\": null,\n      \"title\": \"Implement finite transfers and local reactions\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"Contractile requests are bounded by local actuator capabilities and available fuel; requested and realized work and physical losses remain distinguishable.\",\n        \"Starvation, stalled contraction and unloaded cycling follow the approved energy model without drawing on numerical residual.\",\n        \"A deterministic controller reads only declared local sensors and submits requests rather than mutating physical state.\",\n        \"Focused cycles verify no passive propulsion or cyclic numerical energy gain beyond approved budgets, and seeded replay matches on the declared configuration.\"\n      ],\n      \"components\": [\"C-processes\", \"C-mechanics\", \"C-experiments\"],\n      \"context\": \"Consume A-exchange and A-coupled-design under A-protocol. Implement a scripted actuator mode for physical isolation and one minimal local deterministic controller for the workload; no brain/genome framework. Use simulation-health (.mindgraph/project_capabilities/simulation-health.md; routed simulation-health-diagnostics.md) for repeated-work checks.\",\n      \"depends_on\": [\"T-exchange\", \"T-coupled-design\", \"T-protocol\"],\n      \"goal\": \"Make activity constrained by locally available resources and measurable mechanical work.\",\n      \"id\": \"T-activity\",\n      \"input_artifacts\": [\"A-exchange\", \"A-coupled-design\", \"A-protocol\"],\n      \"parent_id\": \"T-active-lab\",\n      \"plan_review\": null,\n      \"title\": \"Implement work-limited actuation and local control\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"The approved first-proof construction couples tissue, chamber, moving fluid, nutrient uptake and fuel-limited actuation, producing measured useful motion and transport.\",\n        \"No-fuel, sealed-exchange and passive controls separate resource-driven behavior from numerical artifacts.\",\n        \"Measure useful displacement or transported amount, pump work, species/fuel balances, local field errors and complete interval cost across approved resolution comparisons.\",\n        \"Run the timescale-derived horizon with hard-condition monitors and selected complete-state inspections; retain counterexamples and explain remaining drift uncertainty.\",\n        \"Provide one reproducible human-runnable command and actual inspected images correlated with semantic traces.\"\n      ],\n      \"components\": [\"C-state\", \"C-mechanics\", \"C-field\", \"C-processes\", \"C-experiments\", \"C-adapter\"],\n      \"context\": \"Consume A-activity, A-passive-proof and A-protocol. This is the decisive active proof, not population endurance. Use capabilities traces, simulation-health and snapshots-checkpoints through their .mindgraph/project_capabilities hint files and routed tracing-diagnostics.md, simulation-health-diagnostics.md, checkpoints-snapshots.md and visual-qa.md. Checkpoints remain excluded.\",\n      \"depends_on\": [\"T-activity\", \"T-passive-proof\", \"T-protocol\"],\n      \"goal\": \"Determine whether the foundation supports useful resource-limited biological behavior at representative cost.\",\n      \"id\": \"T-active-proof\",\n      \"input_artifacts\": [\"A-activity\", \"A-passive-proof\", \"A-protocol\"],\n      \"parent_id\": \"T-active-lab\",\n      \"plan_review\": {\n        \"question\": \"Does the active proof preserve motion, pumping and resource costs under refinement within the approved complete-cost budget, sufficiently supporting expansion to the 16-organism laboratory?\"\n      },\n      \"title\": \"Qualify the first active coupled organism\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"Crawler, swimmer and chambered pump are authored using the same construction, material, sensing and request interfaces without organism-type branches in core physics.\",\n        \"The laboratory instantiates the frozen 16-organism complexity with shared fluid, physical contact, nutrient competition and continuously active sensing, metabolism and actuation.\",\n        \"The thin Bitloop shell supports fixture selection, fixed-interval advancement and clear display of simulated time, failures and key resource state.\",\n        \"Snapshots and semantic observations demonstrate the three behaviors and shared interactions; reproducible commands/configurations are retained.\"\n      ],\n      \"components\": [\"C-experiments\", \"C-adapter\"],\n      \"context\": \"Conditional on active-proof review. Consume A-active-proof, A-activity and A-protocol. Use bitloop (.mindgraph/project_capabilities/bitloop.md; .agents/skills/bitloop-development/SKILL.md) for existing lifecycle/drawing facilities and snapshots-checkpoints hint/reference paths for visual QA. Exclude drag tooling, checkpoint serialization, thermal state, damage/repair and population evolution.\",\n      \"depends_on\": [\"T-active-proof\", \"T-activity\", \"T-protocol\"],\n      \"goal\": \"Demonstrate composition and shared activity in a small inspectable world.\",\n      \"id\": \"T-lab\",\n      \"input_artifacts\": [\"A-active-proof\", \"A-activity\", \"A-protocol\"],\n      \"parent_id\": \"T-active-lab\",\n      \"plan_review\": null,\n      \"title\": \"Compose the interactive organism laboratory\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"Execute the frozen laboratory horizon and repeated windows, including contact/transport bursts, and report observed invariants, local feature quality, gradient survival and drift with stopping rationale.\",\n        \"Report actual hardware/compiler/build/precision/workers/load, full calculated-frame mean/p95/p99/maximum, retries, memory definition and active structural/field/controller counts.\",\n        \"Assess the proposed one-simulated-second-per-wall-clock-second laboratory target on the declared hardware; absent reference hardware is marked unverified, not inferred.\",\n        \"Separately measure rendering, trace/capture recording and total user-facing throughput; no sleeping or isolated-box substitution supplies the performance claim.\",\n        \"Publish runnable examples, validity limits, failed/skipped checks and lessons. Remove superseded candidate paths and disposable probes after retaining decisive findings.\",\n        \"Do not claim the 256-organism rich-world latency, memory or endurance gates have passed.\"\n      ],\n      \"components\": [\"C-state\", \"C-experiments\", \"C-adapter\"],\n      \"context\": \"Consume A-lab and A-protocol. Use traces and simulation-health at their catalogue hint paths and routed tracing-diagnostics.md, simulation-health-diagnostics.md and temporary-diagnostics.md. Preserve compact findings under .codex/runs, keep high-volume scratch manifest-owned, and put decision-bearing observations in supported mindgraph-result fields. Qualification may recommend rejection; it does not authorize the next scope.\",\n      \"depends_on\": [\"T-lab\", \"T-protocol\"],\n      \"goal\": \"Establish an honest laboratory acceptance result and evidence for deciding the next work package.\",\n      \"id\": \"T-qualification\",\n      \"input_artifacts\": [\"A-lab\", \"A-protocol\"],\n      \"parent_id\": \"T-active-lab\",\n      \"plan_review\": {\n        \"question\": \"Do interacting laboratory trajectories and complete measured costs justify retaining this foundation for a separately approved rich-world package, or do drift, tails, memory or activity costs require representation changes first?\"\n      },\n      \"title\": \"Qualify active laboratory behavior and complete cost\"\n    }\n  ],\n  \"vision_summary\": \"Build an independently owned, physically coherent and affordable 2D organism world whose motion, containment and transport arise from shared local rules and finite resources. This initial plan delivers the supervised workflow, approved numerical foundation, decisive coupled active proof and conditional 16-organism laboratory; larger ecological workloads remain subsequent explicit commitments.\"\n}",
