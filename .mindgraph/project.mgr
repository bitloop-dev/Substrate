({ \"New Projects\", \"Substrate\" });\r\n63:     }\r\n64: \r\n65:     struct UI : BufferedInterfaceModel\r\n66:     {\r\n67:         using BufferedInterfaceModel::BufferedInterfaceModel;\r\n68:         void sidebar();\r\n69:         // void overlay();\r\n70:     };\r\n71: \r\n72:     int viewport_count = 1;\r\n73: \r\n74:     void projectPrepare(Layout& layout) override;\r\n75: };\r\n76: \r\n77: SIM_END;\r\n",
