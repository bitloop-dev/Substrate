                            "output": {
                                "identity": "fnv1a64:419a6ae8db1e7bc5",
                                "lines": "1: param([Parameter(Mandatory)][string]$Run)\n2: $ErrorActionPreference = 'Stop'\n3: Set-StrictMode -Version Latest\n4: \n5: $maxTimeError = 0.0\n6: foreach ($variant in @('primary', 'replay')) {\n7:     $metadata = Get-Content \"$Run/$variant/metadata.json\" -Raw | ConvertFrom-Json\n8:     $summary = Get-Content \"$Run/$variant/summary.json\" -Raw | ConvertFrom-Json\n9:     $frames = @(Get-Content \"$Run/$variant/frames.jsonl\" | ForEach-Object { $_ | ConvertFrom-Json })\n10:     if ($metadata.trace.format -ne 'full' -or $metadata.dt -ne 0.125 -or\n11:         $metadata.frames_requested -ne 8 -or $metadata.selected_scene_ids.Count -ne 1 -or\n12:         $metadata.selected_scene_ids[0] -ne 'substrate-0' -or $frames.Count -ne 8 -or\n13:         -not $summary.ok -or $summary.processed_frames -ne 8 -or $summary.trace_frames -ne 8 -or\n14:         $summary.dropped_objects -ne 0 -or $summary.snapshots_failed -ne 0) {\n15:         throw \"$variant configuration or completion mismatch\"\n16:     }\n17:     for ($i = 0; $i -lt 8; ++$i) {\n18:         $f = $frames[$i]\n19:         $expectedTime = ($i + 1) * 0.125\n20:         $error = [Math]::Abs($f.metrics.diagnostic_time_seconds - $expectedTime)\n21:         $maxTimeError = [Math]::Max($maxTimeError, $error)\n22:         if ($f.frame -ne $i -or $f.dt -ne 0.125 -or $f.time -ne $expectedTime -or\n23:             $f.project -ne 'Substrate' -or $f.scene -ne 'substrate-0' -or\n24:             $f.metrics.diagnostic_ticks -ne ($i + 1) -or $error -ne 0.0 -or\n25:             $f.metrics.diagnostic_kind -ne 'lifecycle_only_no_physics' -or\n26:             $f.objects.Count -ne 0 -or $f.events.Count -ne 0) {\n27:             throw \"$variant frame $i failed the exact lifecycle oracle\"\n28:         }\n29:     }\n30: }\n31: $primaryHash = (Get-FileHash \"$Run/primary/frames.jsonl\" -Algorithm SHA256).Hash\n32: $replayHash = (Get-FileHash \"$Run/replay/frames.jsonl\" -Algorithm SHA256).Hash\n33: if ($primaryHash -ne $replayHash) { throw 'Replay traces differ' }\n34: $snapshots = @(Get-Content \"$Run/primary/snapshots.jsonl\" | ForEach-Object { $_ | ConvertFrom-Json })\n35: if ($snapshots.Count -ne 1) { throw 'Expected exactly one snapshot' }\n36: $snapshot = $snapshots[0]\n37: if (-not $snapshot.rendered -or $snapshot.error -ne '' -or $snapshot.frame -ne 7 -or\n38:     $snapshot.time -ne 1.0 -or $snapshot.resolution.width -ne 800 -or $snapshot.resolution.height -ne 600 -or\n39:     -not (Test-Path \"$Run/primary/$($snapshot.filename)\")) { throw 'Snapshot metadata or file missing' }\n40: $scenes = Get-Content \"$Run/scenes.json\" -Raw | ConvertFrom-Json\n41: if ($scenes.scenes.Count -ne 1 -or $scenes.scenes[0].id -ne 'substrate-0' -or\n42:     -not $scenes.scenes[0].selectable) { throw 'Selectable scene catalogue mismatch' }\n43: [ordered]@{\n44:     passed = $true\n45:     observations_checked = 16\n46:     final_ticks = 8\n47:     final_time_seconds = 1.0\n48:     fixed_dt_seconds = 0.125\n49:     max_time_error_seconds = $maxTimeError\n50:     tolerance_seconds = 0.0\n51:     tolerance_basis = 'Binary-exact 1/8-second lifecycle fixture, not a physical error budget'\n52:     replay_sha256 = $primaryHash\n53:     snapshot = \"primary/$($snapshot.filename)\"\n54:     snapshot_visual_inspection = 'Separate human/agent inspection required; this script checks metadata only'\n55:     physical_claim = 'INCONCLUSIVE: no physical model or physical oracle is exercised'\n56: } | ConvertTo-Json\n",
                                "next_offset": null,
