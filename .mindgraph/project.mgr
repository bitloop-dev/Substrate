    "plan": "{\n  \"architecture\": {\n    \"components\": [\n      {\n        \"id\": \"C-world\",\n        \"name\": \"World state and advancement\",\n        \"responsibility\": \"Own stable structural/material references, authoritative committed state, units, advancement schedule, bounded retries and validity checks. Preserve the last valid state and actual time on failure.\"\n      },\n      {\n        \"id\": \"C-mechanics\",\n        \"name\": \"Structure mechanics\",\n        \"responsibility\": \"Own connected tissue, membranes, fibers and stiff supports; calculate deformation, contact and mechanical reactions at supported resolution.\"\n      },\n      {\n        \"id\": \"C-contents\",\n        \"name\": \"Compartment contents\",\n        \"responsibility\": \"Own well-mixed inventories, mass/inertia closure and pressure derived from actual chamber geometry; expose finite paired transfers and pressure work.\"\n      },\n      {\n        \"id\": \"C-fluid\",\n        \"name\": \"Resolved fluid and transport\",\n        \"responsibility\": \"Own grid control-volume inventories, momentum, pressure solve and species transport in environmental or explicitly resolved internal fluid.\"\n      },\n      {\n        \"id\": \"C-boundary\",\n        \"name\": \"Geometry and exchange coupling\",\n        \"responsibility\": \"Derive cut geometry and sided barriers from authoritative structures; reconcile swept volumes, fluxes, pressure forces, work and support transitions without owning duplicate inventory.\"\n      },\n      {\n        \"id\": \"C-biology\",\n        \"name\": \"Construction and local activity\",\n        \"responsibility\": \"Compose organisms using common material interfaces; own deterministic local controllers and reaction rules that request resource-limited actuation and transfers.\"\n      },\n      {\n        \"id\": \"C-app\",\n        \"name\": \"Bitloop application and experiment adapters\",\n        \"responsibility\": \"Keep Substrate.h/.cpp thin; own configuration, rendering, camera/input, recording, semantic trace adapters and explicit checkpoint serialization.\"\n      }\n    ],\n    \"decisions\": [\n      {\n        \"decision\": \"Keep physics independent of Scene, UI, rendering, input, scenario names, trace formatting and file output.\",\n        \"id\": \"D-boundary\",\n        \"rationale\": \"Preserves independent numerical tests, authoritative ownership and a thin existing application shell.\"\n      },\n      {\n        \"decision\": \"Investigate compliant connected elements, well-mixed chambers and conservative grid flow with explicit sided moving barriers.\",\n        \"id\": \"D-representation\",\n        \"rationale\": \"Tests the preferred affordable representation while exposing small-cell, pressure-solve and two-way coupling risks before biological expansion.\"\n      },\n      {\n        \"decision\": \"Use area-based two-dimensional units and explicit paired amount, impulse and work exchanges; distinguish physical dissipation from numerical residual.\",\n        \"id\": \"D-accounting\",\n        \"rationale\": \"Prevents geometry/inventory disagreement, duplicate ownership and numerical error becoming usable biological energy.\"\n      },\n      {\n        \"decision\": \"Advance requested intervals with bounded staging/retries; never skip time, erase unsupported features or silently freeze active dynamics.\",\n        \"id\": \"D-failure\",\n        \"rationale\": \"Transactional validity and honest failure are hard requirements, but full deep copies at every substep are not prescribed.\"\n      },\n      {\n        \"decision\": \"Qualify passive coupling first, then nutrient/fuel-limited active behavior, then interacting laboratory scale.\",\n        \"id\": \"D-gates\",\n        \"rationale\": \"Passive moving-boundary failure must be discovered before transport and control investment. Active behavior is still mandatory before foundation adoption.\"\n      },\n      {\n        \"decision\": \"Defer automatic representation switching, adaptive refinement, general fracture/remeshing, growth/repair/reproduction, evolution, thermal/phase/electrical models and rich-world scale.\",\n        \"id\": \"D-later\",\n        \"rationale\": \"These remain vision requirements for later work packages, not prerequisites or promised features of the bounded initial laboratory.\"\n      }\n    ],\n    \"relationships\": [\n      {\n        \"from\": \"C-world\",\n        \"relationship\": \"Schedules mechanical proposals and validates their committed state.\",\n        \"to\": \"C-mechanics\"\n      },\n      {\n        \"from\": \"C-world\",\n        \"relationship\": \"Schedules inventory and pressure updates with paired exchange accounting.\",\n        \"to\": \"C-contents\"\n      },\n      {\n        \"from\": \"C-world\",\n        \"relationship\": \"Schedules conservative field advancement and pressure convergence checks.\",\n        \"to\": \"C-fluid\"\n      },\n      {\n        \"from\": \"C-mechanics\",\n        \"relationship\": \"Supplies geometry, motion and supported contact boundaries; receives reaction impulses.\",\n        \"to\": \"C-boundary\"\n      },\n      {\n        \"from\": \"C-boundary\",\n        \"relationship\": \"Supplies sided control volumes, swept-volume fluxes and wall conditions; receives pressure traction and fluid work.\",\n        \"to\": \"C-fluid\"\n      },\n      {\n        \"from\": \"C-boundary\",\n        \"relationship\": \"Supplies actual chamber area and opening geometry; exchanges pressure work and finite transfers.\",\n        \"to\": \"C-contents\"\n      },\n      {\n        \"from\": \"C-biology\",\n        \"relationship\": \"Reads constrained local observations and submits validated local actuation/transfer requests.\",\n        \"to\": \"C-world\"\n      },\n      {\n        \"from\": \"C-app\",\n        \"relationship\": \"Constructs experiments, requests simulated intervals and observes immutable committed state without viewport-dependent advancement.\",\n        \"to\": \"C-world\"\n      }\n    ],\n    \"summary\": \"One project-owned simulation state advances transactionally through explicit mechanical, compartment, field and biological exchanges. The inspected repository currently contains a generated Bitloop shell, empty semantic telemetry and checkpoint hooks returning false; no physical implementation or build compatibility is assumed. A passive coupled qualification precedes downstream biological work, and a resource-limited active proof precedes laboratory expansion.\"\n  },\n  \"artifacts\": [\n    {\n      \"description\": \"Project-owned deterministic fixture, build/launch instructions and retained trace/image references; establishes wiring only.\",\n      \"id\": \"F-pilot\",\n      \"produced_by\": \"T-pilot\",\n      \"title\": \"Reproducible Bitloop diagnostic pilot\"\n    },\n    {\n      \"description\": \"Located specification of owners, units, interfaces, state lifecycle, passive fixtures and proposed budgets.\",\n      \"id\": \"F-contract\",\n      \"produced_by\": \"T-contract\",\n      \"title\": \"Shared physical and state contract\"\n    },\n    {\n      \"description\": \"Implementable constitutive/contact law, solver, failure rules and worked mechanical oracles.\",\n      \"id\": \"F-mechanics-law\",\n      \"produced_by\": \"T-design-mechanics\",\n      \"title\": \"Mechanics algorithm and reference cases\"\n    },\n    {\n      \"description\": \"Geometry-based pressure, mass/inertia, energy/work and transfer contract with validity limits.\",\n      \"id\": \"F-contents-law\",\n      \"produced_by\": \"T-design-contents\",\n      \"title\": \"Compartment algorithm and reference cases\"\n    },\n    {\n      \"description\": \"Control-volume layout, flux/pressure algorithm, boundary conditions, convergence and quantitative references.\",\n      \"id\": \"F-flow-law\",\n      \"produced_by\": \"T-design-flow\",\n      \"title\": \"Stationary flow algorithm and reference cases\"\n    },\n    {\n      \"description\": \"Sided cut geometry, small-cell treatment, swept volumes, traction/work exchanges and support-transition oracles.\",\n      \"id\": \"F-boundary-law\",\n      \"produced_by\": \"T-design-boundary\",\n      \"title\": \"Moving-boundary algorithm and reference cases\"\n    },\n    {\n      \"description\": \"Complete coupled schedule, authoritative exchanges, staging/failure design and predeclared qualification configurations/budgets.\",\n      \"id\": \"F-passive-spec\",\n      \"produced_by\": \"T-reconcile\",\n      \"title\": \"Reconciled passive implementation package\"\n    },\n    {\n      \"description\": \"Implemented state/ID/exchange interfaces and transactional requested-interval advancement with focused failure tests.\",\n      \"id\": \"F-world\",\n      \"produced_by\": \"T-world\",\n      \"title\": \"Authoritative core lifecycle\"\n    },\n    {\n      \"description\": \"Production tissue/fiber/support/contact implementation and located focused reference tests.\",\n      \"id\": \"F-mechanics\",\n      \"produced_by\": \"T-mechanics\",\n      \"title\": \"Tested structural mechanics\"\n    },\n    {\n      \"description\": \"Production compartment inventories and geometry-coupled mass/pressure/work interfaces with reference tests.\",\n      \"id\": \"F-contents\",\n      \"produced_by\": \"T-contents\",\n      \"title\": \"Tested pressure-bearing contents\"\n    },\n    {\n      \"description\": \"Production field/pressure implementation, convergence instrumentation and reference tests.\",\n      \"id\": \"F-flow\",\n      \"produced_by\": \"T-flow\",\n      \"title\": \"Tested stationary field solver\"\n    },\n    {\n      \"description\": \"Production sided-boundary exchanges and prescribed-motion local-conservation tests.\",\n      \"id\": \"F-boundary\",\n      \"produced_by\": \"T-boundary\",\n      \"title\": \"Tested moving geometry operators\"\n    },\n    {\n      \"description\": \"Integrated passive fixtures, reproducible configurations, retained numerical/cost findings and counterexamples; does not itself convey adoption.\",\n      \"id\": \"F-passive\",\n      \"produced_by\": \"T-passive\",\n      \"title\": \"Passive coupled qualification package\"\n    },\n    {\n      \"description\": \"Finite species-transfer algorithms, stoichiometric/energy laws, positivity rules and local-field references.\",\n      \"id\": \"F-transport-law\",\n      \"produced_by\": \"T-design-transport\",\n      \"title\": \"Transport and reaction specification\"\n    },\n    {\n      \"description\": \"Moving-field species transport, finite chamber/permeability exchange APIs and local/global tests.\",\n      \"id\": \"F-transport\",\n      \"produced_by\": \"T-transport\",\n      \"title\": \"Tested conservative transport\"\n    },\n    {\n      \"description\": \"Controller/actuation algorithms, organism fixtures and proposed behavioral, performance and horizon budgets requiring explicit approval.\",\n      \"id\": \"F-active-spec\",\n      \"produced_by\": \"T-design-active\",\n      \"title\": \"Active proof and laboratory specification\"\n    },\n    {\n      \"description\": \"Deterministic constrained controllers, reactions and fuel-limited actuator interfaces with depletion/refeeding tests.\",\n      \"id\": \"F-active\",\n      \"produced_by\": \"T-active\",\n      \"title\": \"Tested local activity implementation\"\n    },\n    {\n      \"description\": \"Locomotion and loaded-pump fixtures with nutrient/fuel coupling, physical/refinement findings and complete-cost measurements.\",\n      \"id\": \"F-active-proof\",\n      \"produced_by\": \"T-active-proof\",\n      \"title\": \"Complete active qualification package\"\n    },\n    {\n      \"description\": \"Three common-rule organism constructions, interacting 16-organism habitat, thin application integration and replayable interactions.\",\n      \"id\": \"F-lab\",\n      \"produced_by\": \"T-lab\",\n      \"title\": \"Interactive shared laboratory\"\n    },\n    {\n      \"description\": \"Versioned checkpoint adapters, seeded recording configurations and reproducible continuation comparisons.\",\n      \"id\": \"F-recording\",\n      \"produced_by\": \"T-recording\",\n      \"title\": \"Recording and restart implementation\"\n    },\n    {\n      \"description\": \"Reproducible full-workload timing, memory, physical quality and endurance findings with limitations and retained raw references.\",\n      \"id\": \"F-lab-qualified\",\n      \"produced_by\": \"T-lab-qualify\",\n      \"title\": \"Laboratory qualification package\"\n    },\n    {\n      \"description\": \"Runnable documented laboratory, supported validity range, build/record/restart instructions and retained regression oracles without obsolete candidates.\",\n      \"id\": \"F-delivery\",\n      \"produced_by\": \"T-deliver\",\n      \"title\": \"Clean initial Substrate delivery\"\n    }\n  ],\n  \"assumptions\": [\n    {\n      \"id\": \"A-scope\",\n      \"statement\": \"This initial work package delivers the coupled proof and interactive laboratory, including crawling, swimming and pumping constructions. The 256-organism rich world, its damage/repair schedule, thermal state and ten-minute endurance campaign are later scope, not claimed by this delivery. The human work-package approval explicitly confirms this boundary.\"\n    },\n    {\n      \"id\": \"A-method\",\n      \"statement\": \"Connected compliant elements, geometry-coupled well-mixed chambers and conservative cut-cell grid flow are hypotheses, not adopted solvers. Failed or inconclusive physical gates block dependent implementation pending review and an explicitly applied plan change.\"\n    },\n    {\n      \"id\": \"A-budgets\",\n      \"statement\": \"Physical scales, error budgets, minimum features, iteration/retry limits and laboratory endurance horizons must be designed and approved before qualification. The proposed laboratory throughput target is at least one simulated second per wall-clock second on the declared reference configuration; no unmeasured rich-world extrapolation establishes acceptance.\"\n    },\n    {\n      \"id\": \"A-ownership\",\n      \"statement\": \"All planned changes stay within Substrate. Framework, dependency-ownership or sibling-project changes require separate explicit authorization immediately before writing; incompatibility is reported rather than repaired outside this boundary.\"\n    },\n    {\n      \"id\": \"A-evidence\",\n      \"statement\": \"Every work task maps its artifact IDs to actual paths and source/configuration identities, retains compact decisive findings, and reports commands, units, thresholds, failures, skipped checks and uncertainty in supported MindGraph result fields. Raw diagnostic runs use .codex/runs; artifacts are not substitutes for recorded outcomes or approval.\"\n    }\n  ],\n  \"questions\": [],\n  \"status\": \"ready\",\n  \"tasks\": [\n    {\n      \"acceptance_criteria\": [\n        \"Map F-pilot to build/launch instructions, deterministic fixture and retained trace/image references; record actual target, configuration and dependency compatibility.\",\n        \"A real fixed-step headless run reports expected time/tick observations and an inspected snapshot; explicitly distinguish workflow success from physical validation.\",\n        \"Submit decision-bearing observations in supported result fields, including a clearly labelled inconclusive physical claim to test review handling.\"\n      ],\n      \"components\": [\n        \"C-app\"\n      ],\n      \"context\": \"Inspected CMakeLists.txt uses bitloop_new_project; Substrate traceFrame is empty and checkpoint hooks return false. Use capability bitloop and traces, with snapshots-checkpoints for one inspected image. Workers load the declared bitloop-development entry and only relevant references. Preserve user build state; use a Codex-owned build. Implement only a deterministic diagnostic observable, not placeholder physics.\",\n      \"depends_on\": [],\n      \"execution_kind\": \"work\",\n      \"goal\": \"Establish a real project-owned build and diagnostic path before physical implementation.\",\n      \"id\": \"T-pilot\",\n      \"input_artifacts\": [],\n      \"parent_id\": null,\n      \"plan_review\": {\n        \"question\": \"Does the pilot provide actual Bitloop observations and correctly limited claims, or do build incompatibility, missing diagnostic support or misleading evidence prevent further implementation?\"\n      },\n      \"title\": \"Run a supervised Bitloop evidence pilot\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"After save/reload, task identity, measurements, limitations, review question/disposition and referenced pilot files remain understandable.\",\n        \"Confirm dependency-ready selection and prerequisite handoff; record a minimal reproducer for any missing context, evidence loss or instruction conflict.\",\n        \"Authorize continuation only if the loop is usable; management repairs occur in their owning project, not the physics core.\"\n      ],\n      \"components\": [\n        \"C-app\"\n      ],\n      \"context\": \"Consume T-pilot's saved terminal result and ensuing review, not merely its files. Use docs/MINDGRAPH_READINESS.md as historical risk context, not proof of current host defects. This is a supervised human check because host save/reload and disposition are outside simulation ownership.\",\n      \"depends_on\": [\n        \"T-pilot\"\n      ],\n      \"execution_kind\": \"human_decision\",\n      \"goal\": \"Confirm that the pilot's evidence survives the management lifecycle.\",\n      \"id\": \"T-loop\",\n      \"input_artifacts\": [\n        \"F-pilot\"\n      ],\n      \"parent_id\": null,\n      \"plan_review\": null,\n      \"title\": \"Verify the saved execution-review-reload loop\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"F-contract specifies authoritative owners, stable IDs versus dense indices, units, area/mass conventions, exchange signs, state lifecycle, failure semantics and checkpoint-relevant state.\",\n        \"Specify fixture geometry, coefficients, minimum feature sizes and local/global oracles for equilibrium, free expansion, compression, sealed motion and support changes.\",\n        \"Propose explicit local/cumulative energy, deformation, volume, leakage and convergence budgets with rationale and refinement comparisons; mark unapproved values.\",\n        \"Define complete-work timing/memory boundaries and a passive rejection screen containing pressure solves, staging, safety checks, retries and representative difficult boundaries.\"\n      ],\n      \"components\": [\n        \"C-world\",\n        \"C-boundary\",\n        \"C-biology\"\n      ],\n      \"context\": \"Apply D-accounting, D-failure and A-scope. Define an early passive deformable chamber in surrounding fluid with translating/rotating and narrowing boundary cases. Reserve interfaces for finite transfer, fuel-limited stress and constrained sensing, but defer their detailed algorithms.\",\n      \"depends_on\": [\n        \"T-loop\"\n      ],\n      \"execution_kind\": \"work\",\n      \"goal\": \"Establish the minimal common contract needed by independent numerical designs.\",\n      \"id\": \"T-contract\",\n      \"input_artifacts\": [],\n      \"parent_id\": null,\n      \"plan_review\": null,\n      \"title\": \"Define shared physical interfaces and qualification fixtures\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"F-mechanics-law defines constitutive laws, mass assignment, solver steps, contact/friction reactions, inversion prevention and bounded failure.\",\n        \"Worked translation, rotation, shear, compression/recovery and supported contact cases predict forces, deformation and energy/work accounts.\",\n        \"Document resolution limits, degeneracy metrics and how future actuator work enters without direct state mutation.\"\n      ],\n      \"components\": [\n        \"C-mechanics\"\n      ],\n      \"context\": \"Use F-contract and D-representation. Select one concrete element/constraint formulation, integration method and supported contact treatment, including stiff supports and fiber stress interfaces; do not build a backend catalogue.\",\n      \"depends_on\": [\n        \"T-contract\"\n      ],\n      \"execution_kind\": \"work\",\n      \"goal\": \"Provide an implementable structural algorithm with measurable error and work.\",\n      \"id\": \"T-design-mechanics\",\n      \"input_artifacts\": [\n        \"F-contract\"\n      ],\n      \"parent_id\": null,\n      \"plan_review\": null,\n      \"title\": \"Design compliant mechanics and contact\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"F-contents-law defines pressure versus actual area/inventory, stored energy, mass/inertia closure, wall forces and paired pressure work.\",\n        \"Worked translating/rotating chamber, free expansion, compression and connected finite-rate exchange examples close the applicable accounts.\",\n        \"Opening-transfer interface specifies amount, momentum and energy ownership; no instantaneous channel mixing or arbitrary ejection velocity.\"\n      ],\n      \"components\": [\n        \"C-contents\"\n      ],\n      \"context\": \"Use F-contract. Well-mixed chemistry must not imply massless contents or invented circulation. Declare where this reduced representation is invalid and where a resolved interior is required.\",\n      \"depends_on\": [\n        \"T-contract\"\n      ],\n      \"execution_kind\": \"work\",\n      \"goal\": \"Resolve chamber pressure, mass/inertia and wall work before implementation.\",\n      \"id\": \"T-design-contents\",\n      \"input_artifacts\": [\n        \"F-contract\"\n      ],\n      \"parent_id\": null,\n      \"plan_review\": null,\n      \"title\": \"Design honest pressure-bearing compartments\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"F-flow-law specifies stored quantities, fluxes, pressure nullspaces, boundary conditions, timestep restrictions and convergence/failure rules.\",\n        \"Worked uniform pressure, channel flow and momentum/viscous decay references include local errors and work accounting.\",\n        \"Specify disconnected regions, narrow supported passages and pressure iteration/memory instrumentation.\"\n      ],\n      \"components\": [\n        \"C-fluid\"\n      ],\n      \"context\": \"Use F-contract and D-representation. Choose one staggered/control-volume formulation, viscosity treatment, pressure solver/preconditioner and convergence criterion. Include environmental and explicitly resolved internal domains.\",\n      \"depends_on\": [\n        \"T-contract\"\n      ],\n      \"execution_kind\": \"work\",\n      \"goal\": \"Specify the grid field and pressure algorithm independently of moving geometry.\",\n      \"id\": \"T-design-flow\",\n      \"input_artifacts\": [\n        \"F-contract\"\n      ],\n      \"parent_id\": null,\n      \"plan_review\": null,\n      \"title\": \"Design conservative stationary flow\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"F-boundary-law defines cut geometry, swept-volume fluxes, side connectivity, traction/work pairing and conservative appearance/disappearance of geometric support.\",\n        \"Worked moving corner, translating thin membrane, narrow passage and freely expanding chamber cases reconcile local geometry and inventories.\",\n        \"Define small-cell limits, continuity tests, collision/no-flux agreement and bounded unsupported-condition outcomes.\"\n      ],\n      \"components\": [\n        \"C-boundary\",\n        \"C-fluid\",\n        \"C-mechanics\",\n        \"C-contents\"\n      ],\n      \"context\": \"Consume all three numerical laws. Select one explicit small-cell stabilization strategy that preserves sided barrier topology and amounts; rejection is preferable to silent wall removal.\",\n      \"depends_on\": [\n        \"T-contract\",\n        \"T-design-mechanics\",\n        \"T-design-contents\",\n        \"T-design-flow\"\n      ],\n      \"execution_kind\": \"work\",\n      \"goal\": \"Make geometry, displaced volume and pressure work discretely compatible.\",\n      \"id\": \"T-design-boundary\",\n      \"input_artifacts\": [\n        \"F-contract\",\n        \"F-mechanics-law\",\n        \"F-contents-law\",\n        \"F-flow-law\"\n      ],\n      \"parent_id\": null,\n      \"plan_review\": null,\n      \"title\": \"Design sided moving geometry and cut-cell exchanges\"\n    },\n    {\n      \"acceptance_criteria\": [\n        \"F-passive-spec resolves all units, signs, duplicated mass risks, geometry timing, boundary conditions, pressure/force exchange and rollback across mechanisms.\",\n        \"Freeze proposed passive configurations, local and global tolerances, refinement comparisons, quality-matched full-cost rejection budgets and horizon rationale.\",\n        \"Specify failure injection and low-frequency passive-motion tests that detect gain, excess damping, leakage and collapsed features.\",\n        \"Identify expected implementation paths and test locations without adding speculative subsystem frameworks.\"\n      ],\n      \"components\": [\n        \"C-world\",\n        \"C-boundary\"\n      ],\n      \"context\": \"Reconcile existing mechanism designs rather than redesigning the whole engine. Choose substep ordering, two-way solve convergence and staging ownership; reserve finite transfer and actuator interfaces.\",\n      \"depends_on\": [\n        \"T-contract\",\n        \"T-design-mechanics\",\n        \"T-design-contents\",\n        \"T-design-flow\",\n        \"T-design-boundary\"\n      ],\n      \"execution_kind\": \"work\",\n      \"goal\": \"Produce an implementable passive work package and predeclared gates.\",\n      \"id\": \"T-reconcile\",\n   